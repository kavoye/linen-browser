{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {
      "comment" : "Not shown to anyone: the empty branch of a conditional tooltip on the sidebar's New Tab and Settings rows, used when the sidebar is wide enough to show the row's own title. Leave the translation empty."
    },
    "“%@” is playing" : {
      "comment" : "Tooltip on the speaker glyph of a collapsed folder in the sidebar, saying which tab inside it is making sound. %@ is the tab's title, written by the website — never translated. Keep the curly quotation marks around it."
    },
    "“%@” wants more access" : {
      "comment" : "Title of the dialog shown when an already-installed extension asks for permissions or website access beyond what it was granted. %@ is the extension’s own name, taken from its manifest and never translated. Curly quotation marks; sentence case with no final full stop, as macOS dialog titles are written."
    },
    "“Allow Once” lasts until you leave this website." : {
      "comment" : "Explanatory line under the question in the permission panel. The quoted phrase is the exact label of the “Allow Once” button in the same panel — translate it identically there and here, and keep the curly quotation marks. Full sentence."
    },
    "(%@ cached)" : {
      "comment" : "Trailing note on the input-token field of the agent activity column's usage footer, reading “12K in (38% cached)”. %@ is an already-formatted percentage (with its own per-cent sign) for the share of input the provider served from its cache. Keep the parentheses; very tight."
    },
    "%@ — answering" : {
      "comment" : "Tooltip on the permission badge in the address bar while a permission request is on screen waiting for an answer. %@ is the localized permission name (Camera, Microphone, Location, Notifications); the em dash and the word after it are a status fragment, not a sentence."
    },
    "%@ · from %@" : {
      "comment" : "Second line of a row in the Downloads list. The first %@ is the size summary (“2.4 MB”, or “1.2 MB of 5 MB” while running); the second %@ is the host the file came from, e.g. example.com. The · is a separator between two facts, not a word."
    },
    "%@ allowed" : {
      "comment" : "Fragment in the one-line summary under a website in the list. %@ is a list of permission names already worded and joined, for example camera and microphone. Lower case: it is joined with other fragments, never shown alone."
    },
    "%@ blocked" : {
      "comment" : "Fragment in the one-line summary under a website in the list, for permissions that were refused. %@ is a list of permission names already worded and joined. Lower case: joined with other fragments, never shown alone."
    },
    "%@ doesn’t offer suggestions." : {
      "comment" : "Caption under the Search suggestions row, shown when the chosen engine has no suggestion service, in which case the switch beside it is disabled. %@ is the search engine's brand name, for example Wikipedia — leave the inserted name as is. Curly apostrophe."
    },
    "%@ in" : {
      "comment" : "Token counter in the footer of the agent activity column, in a monospaced one-line row that reads “3 req · 12K in (38% cached) · 2K out”. %@ is an abbreviated count of tokens sent to the model; “in” is the short form of “sent in”. Extremely tight — keep it to a word or two."
    },
    "%@ in use" : {
      "comment" : "Tooltip on the permission badge in the address bar while a website is actively using a capability. %@ is the permission's own name, itself localized: Camera, Microphone, Location or Notifications. The phrase continues from that noun, so it is a fragment rather than a sentence."
    },
    "%@ isn’t ready" : {
      "comment" : "Settings → Assistant. %@ is the provider name the user chose, e.g. \"Groq\". Title of the warning shown when that provider cannot answer."
    },
    "%@ of %@" : {
      "comment" : "Progress line under a file in the downloads list. The first %@ is the amount received and the second the file's total size, both already formatted by the system, e.g. “3.2 MB of 18 MB”; the order may be changed with positional specifiers."
    },
    "%@ out" : {
      "comment" : "The other half of the same footer line in the agent activity column: %@ is an abbreviated count of tokens the model produced, and “out” is the short form of “returned”. Must balance the “%@ in” string beside it; extremely tight."
    },
    "%@ Suggestions" : {
      "comment" : "Section heading over the search-engine completions in the address bar results list and in the ⌘K palette. %@ is the name of the chosen search engine (DuckDuckGo, Google, Bing…) — a product name, never translated. Title Case."
    },
    "%@ tokens" : {
      "comment" : "Detected context window size on a provider page. %@ is a formatted number, e.g. 32,768."
    },
    "%@ unavailable, using Apple Intelligence" : {
      "comment" : "Status message shown when the chosen model provider cannot answer and Linen falls back to the on-device model. %@ is the provider's name, e.g. OpenAI or Ollama. “Apple Intelligence” is Apple's product name — leave as is."
    },
    "%@ will be imported." : {
      "comment" : "First sentence of the confirmation dialog shown before bookmarks are imported. %@ is a count fragment such as “87 bookmarks”. The sentence “The bookmarks go into a new folder in the sidebar.” follows it."
    },
    "%@ without asking" : {
      "comment" : "Fragment in the one-line summary under a website, naming what the assistant may do there unprompted. %@ is a list of action kinds already worded and joined, for example purchases. Lower case: joined with other fragments."
    },
    "%@: %lld tabs" : {
      "comment" : "One line of the Organize Tabs proposal, shown as a bulleted list: the name of a folder that would be made, then how many tabs would go into it. The name comes from the language model and is not translated. A group always holds two or more tabs, so the plural is constant.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$lld tabs"
          }
        }
      }
    },
    "%@. Pick another provider in Settings." : {
      "comment" : "Status message when the selected model provider cannot be used. %@ is a reason sentence supplied elsewhere and carrying no final full stop, e.g. “Apple Intelligence isn’t available on this Mac”. “Settings” is the name of the app's Settings window."
    },
    "%@’s context is small, and every tool takes a share of it. More than %lld tools can push out page content and confuse smaller models." : {
      "comment" : "Warning on the Tools settings page. %@ is the provider name, %lld the recommended tool count.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@’s context is small, and every tool takes a share of it. More than %2$lld tools can push out page content and confuse smaller models."
          }
        }
      }
    },
    "%lld bookmarks" : {
      "comment" : "Count fragment dropped into the import dialog’s “… will be imported.” and into “Imported ….”. %lld is the number of bookmarks. A mid-sentence fragment, not a sentence of its own.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld bookmark"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld bookmarks"
                }
              }
            }
          }
        }
      }
    },
    "%lld downloads will be removed from the list. The files stay in your Downloads folder." : {
      "comment" : "Explanatory text in the confirmation sheet for clearing the download list, shown both in the downloads popover and on the Downloads settings page. %lld is how many finished downloads disappear from the list. “Downloads folder” is the macOS folder of that name.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld download will be removed from the list. The file stays in your Downloads folder."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld downloads will be removed from the list. The files stay in your Downloads folder."
                }
              }
            }
          }
        }
      }
    },
    "%lld entries" : {
      "comment" : "Detail line beside the “Clear History…” command in the ⌘K palette. %lld is how many history entries exist and would be cleared. Sentence-case caption, no verb, very tight.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld entry"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld entries"
                }
              }
            }
          }
        }
      }
    },
    "%lld folders" : {
      "comment" : "How many tab folders a profile has, shown after “%lld tabs” and joined to it by “ · ”. A fragment, not a sentence. %lld is the number of folders.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld folder"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld folders"
                }
              }
            }
          }
        }
      }
    },
    "%lld installed" : {
      "comment" : "How many extensions a profile has, shown under the word “Extensions” on a profile’s page. A fragment, not a sentence. %lld is the number of extensions.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld installed"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld installed"
                }
              }
            }
          }
        }
      }
    },
    "%lld installed, %lld running." : {
      "comment" : "Caption under the Extensions heading in Settings. The first %lld is how many extensions are installed, the second how many of those are switched on; the order may be changed with positional specifiers."
    },
    "%lld installed, all running." : {
      "comment" : "Caption under the Extensions heading in Settings, used when every installed extension is switched on. %lld is how many are installed."
    },
    "%lld issues" : {
      "comment" : "Small orange badge beside an extension's name on the Extensions settings page; clicking it lists the errors. %lld is how many errors that extension reported. Space is very tight — keep it to two words.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld issue"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld issues"
                }
              }
            }
          }
        }
      }
    },
    "%lld links" : {
      "comment" : "Label on the disclosure control of one step row in the agent activity panel; %lld is how many links that step collected. Alternates with “Inspect” when there are none. Narrow column — keep it short.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld link"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld links"
                }
              }
            }
          }
        }
      }
    },
    "%lld models" : {
      "comment" : "Status line for a local model provider (Ollama, LM Studio) in Settings > Provider, saying how many models it serves. %lld is that count. Shown in a narrow row, so keep it short.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld model"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld models"
                }
              }
            }
          }
        }
      }
    },
    "%lld of %lld" : {
      "comment" : "Match position in the find bar: current match, then total matches, e.g. “3 of 17”. Sits between the field and the arrow buttons.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld of %2$lld"
          }
        }
      }
    },
    "%lld pages kept. Older pages are removed." : {
      "comment" : "Caption under the Keep history for row, saying how many pages the history holds now and that anything past the chosen age is dropped. %lld is the count of pages; use a plural variation if the language needs one. The alternative caption, shown when the history is empty, is No pages recorded yet."
    },
    "%lld pages of history" : {
      "comment" : "One figure in the summary line under a profile on the Profiles settings page, joined to the other figures by “ · ”. %lld is the number of pages that profile has in its history. A fragment, not a sentence.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld page of history"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld pages of history"
                }
              }
            }
          }
        }
      }
    },
    "%lld req" : {
      "comment" : "First field of the agent activity column's usage footer. %lld is how many requests were sent to the model in this tab; “req” is a deliberate abbreviation of “requests”. Monospaced and very tight — abbreviate in your language too.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld req"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld req"
                }
              }
            }
          }
        }
      }
    },
    "%lld steps" : {
      "comment" : "One field of the metadata line under a task's prompt in the agent activity panel, joined with “ · ” into something like “2 min ago · 4.2s · 6 steps”. %lld is how many steps the assistant took. Lowercase fragment; the catalogue carries the plural forms.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld step"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld steps"
                }
              }
            }
          }
        }
      }
    },
    "%lld tabs" : {
      "comment" : "How many tabs a profile has open, shown in the profile list and on a profile’s own page. It is joined to other fragments by “ · ”, so it is a fragment, not a sentence. %lld is the number of tabs.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld tab"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld tabs"
                }
              }
            }
          }
        }
      }
    },
    "%lld visits" : {
      "comment" : "Caption on a frequently-visited site tile on the start page; %lld is how many times the user opened that site. One line in a narrow tile, sentence case.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld visit"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld visits"
                }
              }
            }
          }
        }
      }
    },
    "%lld websites" : {
      "comment" : "Count beside a permission row, saying how many websites have an answer saved for it. %lld is the number; use a plural variation if the language needs one."
    },
    "%lld websites are storing data." : {
      "comment" : "Caption under the Website data row, saying how many websites hold cookies or storage on this Mac. %lld is the count; use a plural variation if the language needs one. Website is one word."
    },
    "%lld websites changed" : {
      "comment" : "How many websites have a permission saved in this profile, shown under “Website permissions” on a profile’s page. A fragment, not a sentence. %lld is the number of websites.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld website changed"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld websites changed"
                }
              }
            }
          }
        }
      }
    },
    "%lld websites will be asked again the next time they ask." : {
      "comment" : "Explanatory text in the confirmation sheet for removing one permission (location, camera, microphone or notifications) from every website, on the Websites settings page. %lld is how many websites had a saved answer for that permission.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld website will be asked again the next time it asks."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld websites will be asked again the next time they ask."
                }
              }
            }
          }
        }
      }
    },
    "•" : {
      "comment" : "The bullet character that starts each item in the list of changes in the release notes sheet. It is a glyph, not text — keep it as it is, or replace it only with the bullet character the target language conventionally uses."
    },
    "`%@` is saved in your Keychain." : {
      "comment" : "Caption under the API key row when a key is stored and can be shown partly hidden. %@ is the masked form of the key, for example the first and last few characters — leave it as it is. The backticks mark it as code and must be kept; Keychain is Apple’s password store, so use Apple’s own name for it."
    },
    "A blank page, with the address bar ready." : {
      "comment" : "Caption for the new-tab choice that opens a blank tab."
    },
    "A day" : {
      "comment" : "An option in the Keep history for pop-up menu on the Privacy settings page; it completes “Keep history for …”. Sits with A week, A month, A year and Forever."
    },
    "A key on its own would fire while you type. Hold a modifier with it, or press a modifier by itself." : {
      "comment" : "Warning shown under the shortcut recorder in Settings > Voice when a key was pressed with no modifier. “Modifier” means a modifier key: ⌘, ⌥, ⇧ or ⌃."
    },
    "A message from “%@”" : {
      "comment" : "Heading of the alert that shows a message a web page asked to display. %@ is the website's hostname, e.g. example.com, inside curly quotes. The page's own text appears below it."
    },
    "A message from this page" : {
      "comment" : "Heading of the alert that shows a message a web page asked to display, used when the page has no hostname to name. The page's own text appears below it."
    },
    "A month" : {
      "comment" : "An option in the Keep history for pop-up menu on the Privacy settings page; it completes “Keep history for …”. Sits with A day, A week, A year and Forever."
    },
    "A new profile starts with no history, tabs, or sign-ins." : {
      "comment" : "Caption on the new-profile page, saying what the profile will contain."
    },
    "A quiet browser with an assistant built in. Setup takes two choices." : {
      "comment" : "Caption under the Welcome to Linen heading on the first onboarding screen. Quiet describes the browser as calm and unobtrusive. The two choices are the screens that follow: which model to use, and what to import."
    },
    "A specific profile" : {
      "comment" : "One of two choices for which profile the browser opens in."
    },
    "A website you choose." : {
      "comment" : "Caption for the new-tab choice that opens a homepage."
    },
    "A week" : {
      "comment" : "An option in the Keep history for pop-up menu on the Privacy settings page; it completes “Keep history for …”. Sits with A day, A month, A year and Forever."
    },
    "A year" : {
      "comment" : "An option in the Keep history for pop-up menu on the Privacy settings page; it completes “Keep history for …”. Sits with A day, A week, A month and Forever."
    },
    "About" : {
      "comment" : "Name of the About page in the Settings sidebar; it holds version and update information."
    },
    "About Linen" : {

    },
    "About Tracker Blocking" : {

    },
    "Acknowledgements" : {
      "comment" : "Row on the About settings page, and the title of the page it opens: the open source packages that ship inside Linen, with the license text of each. Use the established word for a credits list of this kind; Title Case."
    },
    "Actions" : {
      "comment" : "Section heading in the ⌘K palette over the app's own commands (New Tab, Settings, Clear History…). Plural noun, Title Case."
    },
    "Activity" : {
      "comment" : "Title of the Activity tab in the side panel, where the assistant’s steps are listed. A noun on a tab, so keep it to one short word — the tab is narrow and sits beside others."
    },
    "Actual Size" : {
      "comment" : "Command that resets page zoom to 100 per cent: an item in the View menu and in the site controls menu on the toolbar. Title Case, as macOS menu commands are."
    },
    "Add" : {
      "comment" : "Button that creates a new custom provider endpoint in Settings > Provider; the same button reads Save when an existing endpoint is being edited. A verb (a command), not a noun."
    },
    "Add %@ key" : {
      "comment" : "Heading of the popover where an API key is pasted, shown when no key is stored yet. %@ is the provider's name, e.g. OpenAI or Anthropic — vendor names, leave as is."
    },
    "Add a key to let %@ answer." : {
      "comment" : "Settings → Assistant → a provider page. %@ is the provider name, e.g. \"Anthropic\". Caption under the \"Needs a key\" status; the key is an API key."
    },
    "Add a provider" : {
      "comment" : "Settings → Assistant. Title of the page listing providers not yet set up."
    },
    "Add a provider, or fix the one you chose." : {
      "comment" : "Settings → Assistant. Caption under \"Nothing is answering\", offering the two ways out."
    },
    "Add an API key for %@ in Settings to see its models." : {

    },
    "Add an API key for %@ in Settings, or enable Apple Intelligence" : {
      "comment" : "Status message when the chosen provider has no key and there is no fallback. %@ is the provider's name, e.g. OpenAI, Anthropic or Ollama. “Apple Intelligence” is Apple's product name and “Settings” is the app's Settings window."
    },
    "Add Bookmark" : {
      "comment" : "Tooltip on the bookmark button in the toolbar when the current page is not bookmarked. Uses Apple’s concise, action-first toolbar wording. Title Case."
    },
    "Add Key…" : {
      "comment" : "Button in the API key row in Settings > Provider that opens the key-entry popover; it reads Change… once a key is stored. Title Case; the trailing character is a real ellipsis (…) promising a popover, so keep it."
    },
    "Add Profile" : {
      "comment" : "Button that makes the profile described on the new-profile page."
    },
    "Add Profile…" : {
      "comment" : "Row at the end of the profile list that opens the page for making a profile. The ellipsis says a page follows."
    },
    "Add Provider…" : {
      "comment" : "Settings → Assistant. Row that opens the list of providers not yet set up. Matches \"Add Profile…\" on the Profiles page."
    },
    "Address and search" : {
      "comment" : "Accessibility label for the combined address and search field in the browser toolbar. Keep it short and name both functions."
    },
    "Address bar" : {
      "comment" : "Heading of the Search settings group holding the switch that redirects typed questions to the assistant. Names the field at the top of the browser window. A noun."
    },
    "Adds Inspect Element to the page’s right-click menu." : {
      "comment" : "Caption under the Web Inspector switch on the Advanced settings page, and its settings search caption."
    },
    "Adjusting the player…" : {
      "comment" : "One line of the assistant's live activity feed, shown while it changes video or audio playback on the page. A present participle describing what is happening right now; ends with a real ellipsis."
    },
    "Advanced" : {
      "comment" : "Name of the Advanced page in the Settings sidebar and the heading at the top of that page."
    },
    "agent speech" : {
      "comment" : "Detail line under the Enable/Disable Voice command in the ⌘K palette; it names what the command affects — the assistant reading its replies aloud. Lowercase caption fragment; capitalise if your language capitalises nouns."
    },
    "AI replies can be wrong. Check important info." : {
      "comment" : "AI disclosure pinned at the foot of the agent activity column. Must stay short enough to fit one line at the column’s minimum width."
    },
    "AI reply: %@" : {

    },
    "all time" : {
      "comment" : "Lowercase phrase naming the widest time range, inserted mid-sentence into the confirmation before clearing browsing data, which reads roughly: browsing history will be cleared for all time. Deliberately lowercase — do not capitalise it, even in languages that capitalise nouns. The capitalised menu label All time is a separate string."
    },
    "All time" : {
      "comment" : "Option in the Time range pop-up menu on the Privacy settings page, meaning there is no limit on how far back data is cleared."
    },
    "All websites use the defaults" : {
      "comment" : "Shown under “Website permissions” when a profile has changed none."
    },
    "Allow" : {
      "comment" : "Used twice, as a permission-granting word: the confirming button in the alert asking whether a web page may open another app, and the Autoplay setting meaning video and sound may start on their own. On the button it is a verb."
    },
    "Allow “%@” on %@?" : {
      "comment" : "Heading of the alert asking whether the assistant may click a control that would buy, transfer, delete or post something. The first %@ is the control's label taken from the web page (in the page's own language, inside curly quotes); the second is the website's hostname, e.g. example.com."
    },
    "Allow “%@”?" : {
      "comment" : "Heading of the alert asking whether the assistant may click a control that would buy, transfer, delete or post something, used when no website can be named. %@ is the control's label taken from the web page, in the page's own language and inside curly quotes."
    },
    "Allow Assistant on %@?" : {

    },
    "Allow Control" : {

    },
    "Allow Control lets the assistant read and use page controls on %@. Read Only blocks this action. Password and payment fields stay blocked." : {

    },
    "Allow Linen to use the microphone under Privacy & Security > Microphone." : {
      "comment" : "Status message shown when the user holds the push-to-talk shortcut but has refused the microphone. “Privacy & Security” and “Microphone” are macOS names — use the system's own wording; the > separates the settings path. Linen is the application name and is never translated."
    },
    "Allow Once" : {
      "comment" : "Button granting a permission for this visit only: on the permission badge in the toolbar and in the alert asking whether the assistant may click something. It means allow this one time, not permanently. Title Case."
    },
    "Allowed until you leave" : {
      "comment" : "Caption under a permission's name in the site permission panel: the grant lasts only until the user navigates away from the website. Sentence case, one line, tight."
    },
    "Allowed without asking" : {
      "comment" : "Heading of the list of websites the assistant may act on without confirming first. Past participle describing the websites below, not an instruction."
    },
    "Already installed in Linen" : {

    },
    "Also clears your start page tiles and your conversations with the assistant." : {
      "comment" : "Caption under the Browsing history checkbox in the Clear browsing data section, naming the two other things that go with the history. Start page tiles are the frequently visited websites shown on a new tab; the assistant is the AI feature."
    },
    "Also clears your start page tiles." : {
      "comment" : "Message in the Clear history dialog, which clears history only. Start page tiles are the frequently visited websites shown on a new tab, and they go because they are built from history. Third person singular."
    },
    "Always Allow" : {
      "comment" : "Grants a permission permanently: a button on the permission badge in the toolbar, and the saved policy shown in the pop-up menus for camera, microphone, location and notifications on the Websites settings page. Title Case."
    },
    "Always Allow on %@" : {
      "comment" : "Button in the alert asking whether the assistant may click a sensitive control; it grants that category for one website only. %@ is the website's hostname, e.g. example.com. Title Case."
    },
    "Always allowed" : {
      "comment" : "Caption under a permission's name in the site permission panel: the site has a permanent grant. Sentence case, one line, tight."
    },
    "Always ask the assistant" : {
      "comment" : "Title of the Settings switch that sends anything you type in the address bar to the assistant instead of the search engine. \"Always\" is about typed questions only — a link or a web address still opens as usual, which the caption underneath says. The feature is called the assistant throughout, never \"AI\". Sentence case, no final full stop."
    },
    "An HTML file exported from Safari, Chrome, Firefox, or Edge." : {
      "comment" : "Caption under the Bookmarks row in the Import section of the General settings page, and the caption of that same row in Settings search. The four names are products — leave them as they are."
    },
    "An HTML file from another browser." : {
      "comment" : "Caption under the Bookmarks row on the last onboarding screen. It names the file the user picks. It must stay on one line, so it is shorter than its twin on the General settings page."
    },
    "and %lld more" : {
      "comment" : "Last bullet after a list of website names in the extension install confirmation dialog, when more than eight sites are covered. %lld is how many further websites are not listed. It sits after a bullet character supplied by the app, so it starts mid-line and takes no full stop.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "and %lld more"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "and %lld more"
                }
              }
            }
          }
        }
      }
    },
    "Another copy of Linen is open. Nothing here is saved." : {
      "comment" : "Brief notice at the bottom of the window when Linen starts while another copy of it already has the session open — a second build during development, usually. That copy keeps the tabs; this window opens empty and writes nothing down. Sentence case, two short sentences."
    },
    "Answers immediately. The fastest option, but weak at multi-step tasks." : {
      "comment" : "Caption under the Thinking segmented control in Settings > Provider, describing the None level of reasoning effort."
    },
    "Anthropic" : {
      "comment" : "Vendor name, shown as the API dialect a custom endpoint speaks. Leave as is."
    },
    "Any server that uses the OpenAI chat API." : {
      "comment" : "Settings → Assistant → Add a provider. Caption on the row for connecting a server the user runs themselves."
    },
    "API key" : {
      "comment" : "Title of the row in Settings > Provider where the provider's API key is stored, and the title of that same row when it turns up in Settings search. “API key” is the standard technical term."
    },
    "API key required" : {
      "comment" : "Chip above the Remote model card on the model-choice onboarding screen, saying what that choice needs before it will work. It pairs with “On Device” on the card beside it. API key is the established term for the credential a provider issues. Title Case, and only a few characters wide."
    },
    "Appearance" : {
      "comment" : "Name of the Appearance page in the Settings sidebar and the heading at the top of that page."
    },
    "Appearance, downloads, and keyboard shortcuts are shared by every profile." : {
      "comment" : "Footnote naming the settings that profiles share."
    },
    "Appearance, search, privacy, websites, and downloads go back to their defaults. Tabs, history, shortcuts, and your provider aren’t affected." : {
      "comment" : "Explanatory text in the confirmation sheet for Reset settings on the Advanced settings page. Each noun names a Settings page or area; keep the order so it matches the pages in the sidebar. Curly apostrophes."
    },
    "Apple Intelligence" : {
      "comment" : "Apple's product name — leave as is. Used as the value in the Model row in Settings > Provider when the on-device model is chosen, and as the title of the left card on the model-choice onboarding screen."
    },
    "Apple Intelligence isn’t available on this Mac" : {
      "comment" : "Reason text explaining why the on-device provider cannot answer. It is fed into other sentences, such as “%@. Pick another provider in Settings.”, so it deliberately carries no final full stop. Curly apostrophe."
    },
    "Apple Intelligence unavailable, using OpenAI" : {
      "comment" : "Status message shown when the on-device model cannot answer and Linen falls back to OpenAI. Both are product/vendor names — leave as is."
    },
    "Applies to every provider that supports it." : {
      "comment" : "Settings → Assistant. Footnote under the thinking-effort choice, saying the setting is shared rather than per provider."
    },
    "Apply" : {
      "comment" : "Button beside the field where a model identifier is typed by hand in Settings > Provider. A verb (a command)."
    },
    "ask" : {
      "comment" : "Hint word printed beside a key cap under the address field — “⌘ ↩ ask” beside the Return hint, and “↩ ask” when the line starts with @ or when the browser is set to agent-only input. It means: send this to the assistant. One lowercase verb, tiny type."
    },
    "Ask" : {
      "comment" : "The policy meaning Linen asks each time before a website may use a permission; an option in the pop-up menus on the Websites settings page. A verb here, not the noun “a question”."
    },
    "Ask %@" : {
      "comment" : "Section heading over the assistant's row in the address bar results and in the ⌘K palette. %@ is the name of the answering provider and model, e.g. “OpenAI (gpt-5.6-luna)” — never translated. “Ask” is the verb. Title Case."
    },
    "Ask Again" : {
      "comment" : "Words that replace the footer of a recent-task card on the start page while the pointer is over it; clicking the card runs the same prompt again. Verb phrase in Title Case, one line in a narrow card."
    },
    "Ask again: %@" : {
      "comment" : "Tooltip on a recent-task card on the start page. %@ is the user's own earlier prompt, quoted back as they wrote or spoke it — never translated. Keep the colon."
    },
    "Ask anything" : {
      "comment" : "Large heading above the ask field on the start page, shown when the browser is set to agent-only input. Imperative invitation, sentence case; alternates with “Search anything”."
    },
    "Ask where to save each file" : {
      "comment" : "Title of the switch on the Downloads settings page that makes Linen prompt for a folder on every download, and the title of that same row in Settings search. Sentence case."
    },
    "Ask, or enter website name" : {
      "comment" : "Placeholder in the address/ask field when the browser is set to agent-only input, where there is no web search. Sentence case; “Ask” is the verb. Match the wording of “Search, “@” to ask, or enter website name”."
    },
    "Asks each time" : {
      "comment" : "Caption under a permission's name in the site permission panel: nothing is on record, so the browser will put the question again on every request. Third person, sentence case, one line."
    },
    "Assistant" : {
      "comment" : "Fallback name for the assistant before a model provider is configured. A short noun used in headings and settings captions."
    },
    "Assistant access" : {
      "comment" : "Row title on a single website's settings page, choosing how much of that page the assistant may use: Ask, Read Only, Allow Control or No Access. Sentence case here; the same choice appears Title Case as a menu in the browser toolbar, which is a different surface."
    },
    "Assistant Access" : {

    },
    "Assistant access is off for %@. Change it in Site Settings." : {

    },
    "Assistant access wasn’t allowed on %@." : {

    },
    "assistant has no access" : {
      "comment" : "Fragment in the one-line summary under a website, meaning the assistant may neither read nor use it. Lower case: joined with other fragments."
    },
    "assistant may control" : {
      "comment" : "Fragment in the one-line summary under a website, meaning the assistant may also click, type and scroll on it. Lower case: joined with other fragments."
    },
    "assistant may read" : {
      "comment" : "Fragment in the one-line summary under a website, meaning the assistant may see the page text but not use its controls. Lower case: joined with other fragments by a separator, never shown alone."
    },
    "Assistant provider and key" : {
      "comment" : "Something a profile keeps separately from every other profile."
    },
    "Attach a debugger to pages" : {
      "comment" : "One line in the bulleted list of what an extension will be able to do, in the install confirmation sheet. It completes the introduction “It will also be able to:”, so keep it a bare verb phrase."
    },
    "Attach Tab" : {

    },
    "Auto" : {
      "comment" : "Theme choice that automatically follows the Mac’s Light or Dark appearance. A short label beneath a visual preview."
    },
    "Automatic Picture in Picture" : {
      "comment" : "Title of the row on the General settings page that makes video float in its own window on its own, and the title of that same row in Settings search. “Picture in Picture” is the macOS name of that window — use the system’s own wording. Title Case."
    },
    "Automatic Picture in Picture is off while “Show video in the player” is on in Experiments." : {
      "comment" : "Footnote under the Media card on the General settings page, shown only while the Experiments row is on and the Automatic Picture in Picture switch above is dimmed. It says why that switch cannot be used. The quoted phrase is the exact title of the Experiments row — translate it identically there and here, and keep the curly quotation marks. Full sentence."
    },
    "Autoplay" : {
      "comment" : "Title of the row on the Websites settings page controlling whether video and sound may start on their own, and the title of that same row in Settings search. A noun; the browser term."
    },
    "Available to this key" : {
      "comment" : "Heading of the section of the model pop-up menu listing models the stored API key can reach; the parallel heading for local providers is “Pulled locally”. “Key” means the API key."
    },
    "Back" : {
      "comment" : "The command that goes back one page in a tab: an item in the History menu, and the tooltip on the back button at the top of the History page. A direction, not the verb “to back”."
    },
    "Back 15 seconds" : {
      "comment" : "Tooltip on the skip-back button in the media player docked at the foot of the sidebar. The player jumps back exactly fifteen seconds; keep the number. “Back” is directional, not the browser's Back command."
    },
    "Back to %@" : {
      "comment" : "Tooltip on the return arrow of a bookmarked tab that has wandered off its anchor — on the sidebar row and on the toolbar's bookmark button. %@ is the bookmarked page's own title or host, or the fallback phrase “the bookmarked page”, so it drops in mid-sentence. “Back” is directional, not the browser's Back command."
    },
    "Back to Bookmarked Page" : {
      "comment" : "Command that returns a tab to the page bookmarked in it: a File menu item, a search palette command, and a tab context-menu item. Title Case, as menu commands are."
    },
    "background scripts" : {
      "comment" : "The same kind of data named partway through a sentence, joined with others into a summary under a website's name. Lower case; never shown alone."
    },
    "Background scripts" : {
      "comment" : "One kind of data a website stores: service workers, which are scripts a website leaves behind to run when it is not open. Named for what it does rather than by its technical name."
    },
    "balanced · default" : {
      "comment" : "Short note beside one suggested model in the model pop-up menu, marking it as the balanced choice and the one used unless another is picked. The middle dot separates the two words and should be kept. Lowercase, and the space is very tight."
    },
    "Base URL" : {
      "comment" : "Title of the field on the custom endpoint page where the model server's address is typed. Technical term — the address a client sends requests to."
    },
    "Best for longer, complex tasks. Your key stays in your Keychain." : {
      "comment" : "Caption for the remote-model choice on the onboarding provider screen. Keychain is the macOS password store — use Apple's own name for it."
    },
    "Blank" : {
      "comment" : "Option in the New tab segmented control on the General settings page: new tabs open with an empty page. An adjective; space in a segment is tight, so keep it to one short word."
    },
    "Block and rewrite network requests" : {
      "comment" : "One line in the bulleted list of what an extension will be able to do, in the install confirmation sheet. It completes “It will also be able to:”."
    },
    "Block known trackers" : {

    },
    "Block pop-ups" : {
      "comment" : "Title of the switch on the Websites settings page, and the title of that same row in Settings search. “Block” is a verb; “pop-ups” are windows a site opens by itself. Sentence case."
    },
    "Block Trackers" : {

    },
    "Block trackers on every website." : {
      "comment" : "Settings search description for the Block known trackers switch. Every website distinguishes it from the same switch on one website's page. Imperative."
    },
    "Blocked on this page" : {

    },
    "Blue" : {
      "comment" : "Tooltip and accessibility label for one swatch in the colour row of a sidebar folder's context menu, the way the Finder labels its tag colours. A colour name on its own, Title Case; the swatch is 18 points across, so keep it to one word."
    },
    "Bookmark This Page" : {
      "comment" : "Command that makes the page now open the tab's anchor, so the tab can always return to it. Three surfaces share it: the context menu of a tab row in the sidebar, the search palette, and the File menu on ⌘D. Title Case. “Bookmark” is the browser's noun for that anchor; there is no separate bookmarks list."
    },
    "Bookmarks" : {
      "comment" : "Title of the row that imports bookmarks, in the Import section of the General settings page and on the last onboarding screen. A noun."
    },
    "Bring All to Front" : {
      "comment" : "Standard macOS item at the bottom of the Window menu. Use the system's own wording. Title Case."
    },
    "Bring your bookmarks over" : {
      "comment" : "Heading of the last onboarding screen, where the user imports bookmarks from another browser and makes Linen the default browser. An invitation, not a command."
    },
    "Browse extensions to install" : {
      "comment" : "Tooltip on the Chrome Web Store button on the Extensions settings page."
    },
    "Browser" : {
      "comment" : "Heading of the first group in the Settings sidebar, covering the General and Appearance pages. A noun."
    },
    "Browsing" : {
      "comment" : "Heading of the Settings sidebar group covering the Privacy, Websites, Downloads and Extensions pages. A noun naming the activity, not an instruction."
    },
    "Browsing %@…" : {
      "comment" : "Caption under the live snapshot in the agent activity column while the assistant is on a page. %@ is the page's host, e.g. example.com, or the fallback phrase “the research page”, so it is a noun dropped mid-sentence. Real ellipsis character — keep it."
    },
    "browsing history" : {
      "comment" : "Lowercase name of one kind of browsing data, inserted mid-sentence into the confirmation before clearing, which reads roughly: browsing history and cached files will be cleared for the last hour. Deliberately lowercase — do not capitalise it, even in languages that capitalise nouns. The capitalised row label Browsing history is a separate string."
    },
    "Browsing history" : {
      "comment" : "Name of one of the three kinds of data listed with tick boxes on the Privacy settings page. A noun phrase at the head of a row; a separate lowercase variant exists for use inside sentences, so this one may take the language's normal capitalization."
    },
    "Browsing now" : {
      "comment" : "Caption under the profile you are currently in, in the profile switcher — also under Private Browsing while it is the active session. A status, not a command."
    },
    "cached files" : {
      "comment" : "Lowercase name of one kind of browsing data, inserted mid-sentence into the confirmation before clearing, which reads roughly: browsing history and cached files will be cleared for the last hour. Deliberately lowercase — do not capitalise it, even in languages that capitalise nouns. The capitalised row label Cached files is a separate string."
    },
    "Cached files" : {
      "comment" : "Name of one of the three kinds of data listed with tick boxes on the Privacy settings page. A noun phrase at the head of a row; a separate lowercase variant exists for use inside sentences."
    },
    "camera" : {
      "comment" : "Lowercase name of one website permission, inserted mid-sentence into the confirmation: Are you sure you want to remove the camera setting for every website? Deliberately lowercase — do not capitalise it, even in languages that capitalise nouns. The capitalised row label Camera is a separate string."
    },
    "Camera" : {
      "comment" : "Name of the camera permission: a row on the Websites settings page and a label in the permission badge in the toolbar."
    },
    "Can read" : {
      "comment" : "Label before the list of pages the assistant is allowed to read for this question: the page or split panes on screen, plus any attached tabs."
    },
    "Can’t find this website" : {
      "comment" : "Headline on the error page shown when a website's address cannot be resolved. Curly apostrophe; the explanatory sentence below it is a separate entry."
    },
    "Can’t reach this website" : {
      "comment" : "Headline on the error page shown when the server refuses the connection. Curly apostrophe; the explanatory sentence below it is a separate entry."
    },
    "Cancel" : {
      "comment" : "The standard Cancel button in confirmation sheets and alerts throughout the app. Use the system's own wording for it."
    },
    "Cancel shortcut recording" : {
      "comment" : "Tooltip on the shortcut recorder in Settings > Voice while it is listening for a key combination; pressing it stops without recording anything."
    },
    "Canceled" : {
      "comment" : "Status label on a download the user stopped."
    },
    "Canceled." : {
      "comment" : "Tool result and trace line when an agent step was cancelled mid-run."
    },
    "Certificate exceptions" : {

    },
    "Change in Settings…" : {

    },
    "Change the keyboard shortcut" : {
      "comment" : "Tooltip on the shortcut recorder in Settings > Voice while it is idle; pressing it starts listening for a new key combination."
    },
    "Change the model or how much it thinks" : {

    },
    "Change…" : {
      "comment" : "Button that reopens the API key popover once a key is stored; it reads Add Key… when none is. A verb, with a real ellipsis (…) promising a popover."
    },
    "cheapest" : {
      "comment" : "Short note beside one suggested model in the model pop-up menu, marking it as the least expensive to use. Lowercase superlative, and the space is very tight."
    },
    "Check for Updates" : {
      "comment" : "Button in the update row on the About settings page that asks the update server whether a newer release exists. Title Case; a command."
    },
    "Check for Updates…" : {

    },
    "Check this provider again" : {
      "comment" : "Settings → Assistant → a provider page. Tooltip on the refresh button beside the readiness status."
    },
    "Checking for updates" : {
      "comment" : "Status line in the update row on the About settings page while a check is running."
    },
    "Checking for updates…" : {
      "comment" : "Status line in the update row on the About settings page while a check is running."
    },
    "Checking this page…" : {

    },
    "Checking…" : {
      "comment" : "The update button's title, and the update status shown in the sidebar, while a check is running. Ends with a real ellipsis (…), not three dots."
    },
    "Choose" : {
      "comment" : "Used twice, as a verb: the placeholder in a Settings pop-up menu with nothing selected yet, and the confirm button of the macOS folder-picking panel for the download folder — for the second, use the wording macOS itself puts on that button."
    },
    "Choose a Different Match" : {
      "comment" : "Tooltip on the ⋯ button at the top of the lyrics view. Its menu lists the other entries the lyrics library holds for this song, so the user can pick a better one. Title Case."
    },
    "Choose a location every time." : {
      "comment" : "Caption for the “Ask where to save each file” row in Settings search results. “Location” means a folder on disk."
    },
    "Choose a model" : {

    },
    "Choose File…" : {
      "comment" : "Button beside the Bookmarks row. It opens the macOS file panel, where the user picks the exported bookmarks file. The ellipsis says that a panel opens; keep it."
    },
    "Choose From Menus" : {
      "comment" : "Tool name in assistant settings: picking an option in a dropdown on a web page."
    },
    "Choose Site Settings in the toolbar to change one." : {
      "comment" : "Guidance under No websites changed, saying where per-website settings are made. Site Settings is the name of a menu in the browser toolbar — translate it the same way there. Imperative."
    },
    "Choose Standard or Liquid Glass." : {
      "comment" : "Caption below Window style in Appearance settings and the same wording in Settings search. Standard and Liquid Glass are the exact names of the two choices."
    },
    "Choose the bookmarks file you exported from another browser." : {
      "comment" : "Message at the top of the macOS file panel that Choose File… opens. It tells the user which file to pick."
    },
    "Choose what to clear and how far back to go. This can’t be undone." : {
      "comment" : "Message in that dialog, naming its two controls: the checkboxes for what, and the time-range menu for how far back. Do not list the kinds themselves here — they are the checkbox labels, and unticking one would make a list go stale. Curly apostrophe."
    },
    "Choose Which Tab the Words Follow" : {
      "comment" : "Tooltip on the lyrics panel title while more than one tab has media; the title opens a menu that lists those tabs so the user can pick which one the lyrics follow. Title Case. Twin of “Choose Which Tab to Control”, which is the same control on the media dock."
    },
    "Choose Which Tab to Control" : {
      "comment" : "Tooltip on the media dock title while more than one tab is playing; the title opens a menu that lists those tabs so the user can pick which one the transport drives. Title Case, narrow dock."
    },
    "Choose…" : {
      "comment" : "Button on the Downloads settings page that opens the macOS panel for picking the download folder. A verb, with a real ellipsis (…) promising a panel."
    },
    "Choosing “%@”…" : {
      "comment" : "Line in the assistant's live activity feed while it picks an option from a menu on the page. %@ is the option's text as it appears on the page, in that page's own language, inside curly quotes. Present participle; real ellipsis."
    },
    "Choosing an option…" : {
      "comment" : "Line in the assistant’s live activity feed while it picks from a menu whose option text is unknown. Present participle; real ellipsis."
    },
    "Chrome extensions running in Linen." : {

    },
    "Chrome Web Store" : {
      "comment" : "Button on the Extensions settings page that opens Google's extension store in a tab. Product name — leave as is."
    },
    "Claude, with extended thinking control." : {
      "comment" : "One-line description of the Anthropic provider in the provider list in Settings, also shown in that row's tooltip. “Claude” is the model's product name — leave as is; “extended thinking” is Anthropic's term for its reasoning mode."
    },
    "Clear" : {
      "comment" : "Always a verb on a control: the clear buttons on the History page and Privacy settings, the confirming button in their shared alert, and a tooltip in the command palette. Not the adjective “clear”."
    },
    "Clear browsing data" : {
      "comment" : "Heading of the section on the Privacy settings page for deleting history, cookies and caches, and the title of that same row in Settings search. Sentence case; a verb phrase."
    },
    "Clear browsing data?" : {
      "comment" : "Title of the dialog opened by the Clear button in Privacy settings. The dialog holds a time-range menu and a checkbox for each kind of data, so the title asks the question the controls answer. Sentence case with a question mark, as macOS dialog titles are written."
    },
    "Clear History" : {
      "comment" : "Button that confirms clearing one profile’s history."
    },
    "Clear history?" : {
      "comment" : "Heading of the confirmation sheet for deleting all browsing history, raised from the History page, the History menu and the command palette. The detail sentence and buttons are separate entries."
    },
    "Clear History…" : {
      "comment" : "Command that raises the confirmation for deleting all browsing history: an item in the History menu and an action in the command palette. Title Case; the real ellipsis (…) promises a dialog rather than an immediate wipe, so keep it."
    },
    "Clear List" : {
      "comment" : "The destructive confirming button in the sheet that empties the list of finished downloads. Title Case; “Clear” is a verb and “List” is the downloads list, not the files."
    },
    "Clear on quit" : {
      "comment" : "Title of the switch that empties cookies, site data and caches every time Linen closes, and the title of that same row in Settings search. Sentence case; “Clear” is a verb and “quit” means closing the app."
    },
    "Clear Search" : {

    },
    "Clear shows more of what’s behind Linen. Tinted adds contrast to content and controls." : {

    },
    "Clear the download list?" : {
      "comment" : "Heading of the confirmation sheet for emptying the list of finished downloads, raised from the downloads popover and from the Downloads settings page. Only the list is emptied, not the files."
    },
    "Clear the history in “%@”?" : {
      "comment" : "Question in the dialog that confirms clearing one profile’s history. %@ is a profile name."
    },
    "Clear…" : {
      "comment" : "Button on the Downloads settings page that raises the confirmation for emptying the download list. A verb, with a real ellipsis (…) promising a dialog."
    },
    "Click" : {
      "comment" : "Tool name in assistant settings: clicking controls on a web page."
    },
    "Click for options · drag to move this page" : {
      "comment" : "Tooltip on the small pill floating over each page shown beside another. Two hints for the same control, separated by an interpunct: a click opens its menu, a drag moves the page. Sentence case, no final period."
    },
    "Click to Talk" : {
      "comment" : "Tooltip on the microphone button in the toolbar while it is idle: one click starts listening. Title Case; alternates with “Stop and Run”."
    },
    "Clicking “%@”…" : {
      "comment" : "Line in the assistant's live activity feed while it clicks something on the page. %@ is the control's label as it appears on the page, in that page's own language, inside curly quotes. Present participle; real ellipsis."
    },
    "Clicking…" : {
      "comment" : "Line in the assistant's live activity feed while it clicks something whose label is unknown. Present participle; real ellipsis."
    },
    "Close" : {
      "comment" : "Tooltip on the × button of the release notes sheet. A verb."
    },
    "Close (esc)" : {
      "comment" : "Tooltip on the round button at the right of the ⌘K palette's field while the field is empty, where it closes the palette. “esc” names the Escape key as printed on the keyboard — keep it exactly, including the parentheses and the lowercase."
    },
    "Close %lld Tabs" : {
      "comment" : "Context-menu command on a multi-row sidebar selection; it closes every selected tab, including the ones inside selected folders. %lld is that count. Title Case, as menu commands are.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Close %lld Tab"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Close %lld Tabs"
                }
              }
            }
          }
        }
      }
    },
    "Close %lld tabs?" : {
      "comment" : "Heading of the confirmation alert raised by “Close N Tabs” in the context menu of a multi-row sidebar selection. %lld is how many tabs are about to close, counting the ones inside any selected folder. Keep the question mark."
    },
    "Close a tab in the conversation." : {
      "comment" : "Caption for the Close Tabs tool in assistant settings."
    },
    "Close Other Pages" : {
      "comment" : "Destructive command that closes every page shown alongside the one in focus, leaving that one. Title Case. A View menu item and a page context-menu item."
    },
    "Close Other Tabs" : {
      "comment" : "Tab context menu in the sidebar: closes every tab except the one that was right-clicked. Asks first. Title case, no count — the confirmation names the number."
    },
    "Close Tab" : {
      "comment" : "Command that closes the current tab: a File menu item and a tab context-menu item. Title Case, as menu commands are."
    },
    "Close Tabs" : {
      "comment" : "Button that goes ahead and closes them, in the confirmation alert raised by “Close N Tabs”. Title Case. It names the action rather than saying OK."
    },
    "Close the Player" : {
      "comment" : "Tool name in assistant settings: closing the media player."
    },
    "Close These Tabs" : {
      "comment" : "Destructive context-menu command on a sidebar row that holds two to four pages shown at once; it closes all of them. Title Case."
    },
    "Close This Page" : {
      "comment" : "Destructive context-menu command on a page shown beside another; it closes that page's tab. Title Case. This distinguishes it from Close Other Page directly below it."
    },
    "Close Window" : {
      "comment" : "Standard macOS File menu item that closes the window. Use the system's own wording. Title Case."
    },
    "Closing the tab…" : {
      "comment" : "Line in the assistant's live activity feed while it closes a tab. Present participle; real ellipsis."
    },
    "Closing the video…" : {
      "comment" : "Line in the assistant's live activity feed while it closes a video it had opened. Present participle; real ellipsis."
    },
    "Collapse Side Panel" : {
      "comment" : "Tooltip on the arrows button while the side panel fills the window. It puts the panel back to its narrow width beside the page. Pairs with “Expand Side Panel”. Title Case."
    },
    "Color" : {
      "comment" : "Label of the color swatches that tint a profile’s symbol."
    },
    "completes a purchase" : {
      "comment" : "Clause that completes the sentence This … and usually can’t be undone. in the dialog asking the user to approve an action the assistant wants to take. Lowercase, third person singular, and the implied subject is the action being approved."
    },
    "Connect any server that uses the OpenAI chat API, usually a base URL ending in /v1." : {
      "comment" : "Caption under the Custom endpoint heading in Settings > Provider. “OpenAI” is a vendor name and “/v1” is a literal URL path — leave both exactly as they are."
    },
    "Connection is not secure" : {
      "comment" : "Label for the open-padlock glyph in the address bar on a plain http page. Complete sentence in sentence case, no final period."
    },
    "Connection is secure" : {
      "comment" : "Label for the padlock in the address bar on an https page. Complete sentence in sentence case, with no final period."
    },
    "Contents" : {
      "comment" : "Heading over the list of what one profile is holding."
    },
    "Context window" : {
      "comment" : "Row title on a provider page: the model’s context window size."
    },
    "Continue" : {

    },
    "Continue only if you expected this — a development server, or a proxy your organization runs. The exception lasts until you quit." : {

    },
    "Continue past a certificate macOS rejects. Forgotten when you quit." : {

    },
    "cookies" : {
      "comment" : "The same kind of data named partway through a sentence, joined with others into a summary under a website's name. Lower case; never shown alone."
    },
    "Cookies" : {
      "comment" : "One kind of data a website stores, shown beside a website's name in the Website data list. The standard web term; keep the word browsers use in this language."
    },
    "cookies and site data" : {
      "comment" : "Lowercase name of one kind of browsing data, inserted mid-sentence into the confirmation before clearing, which reads roughly: cookies and site data will be cleared for the last hour. Deliberately lowercase — do not capitalise it, even in languages that capitalise nouns. The capitalised row label Cookies and site data is a separate string."
    },
    "Cookies and site data" : {
      "comment" : "Name of one of the three kinds of data listed with tick boxes on the Privacy settings page. A noun phrase at the head of a row; a separate lowercase variant exists for use inside sentences."
    },
    "Cookies, site data, and cached files, every time Linen closes." : {
      "comment" : "Caption for the Clear on quit row on the Privacy settings page: what is deleted each time the app quits. A sentence fragment; site data is a fixed compound."
    },
    "Copy" : {
      "comment" : "Standard macOS Edit menu item. Use the system's own wording. A verb."
    },
    "Copy Link" : {
      "comment" : "Command that puts the current page's address on the clipboard: an Edit menu item, an item in the site controls menu on the toolbar, and a tab context-menu item. Title Case."
    },
    "Copy Links" : {
      "comment" : "Sidebar context menu on a split row or several selected tabs: puts one web address per line on the clipboard. Plural of Copy Link. Title case."
    },
    "Couldn’t build the download URL" : {
      "comment" : "Error shown when an extension cannot be fetched because its download address could not be assembled. A technical failure message, shown to the user."
    },
    "Couldn’t check for updates" : {
      "comment" : "Status line in the update row on the About settings page when the check failed. Curly apostrophe. Also the title of the sidebar update card when the check fails; the two slots share this key."
    },
    "Couldn’t reach %@" : {
      "comment" : "Error shown when the model provider's server does not answer. %@ is the server address, e.g. http://localhost:11434 — an address, not a name. Curly apostrophe."
    },
    "Couldn’t reach the model provider. Check its connection and API key in Settings." : {
      "comment" : "The assistant's reply text when a request to the model failed and there is no more specific error. “Settings” is the app's Settings window. Curly apostrophe."
    },
    "Couldn’t set up speech: %@" : {
      "comment" : "Status line shown when the speech recogniser could not be started. %@ is the underlying error description supplied by macOS, which arrives already translated by the system."
    },
    "Couldn’t start the microphone: %@" : {
      "comment" : "Status message shown when voice input cannot start. %@ is the system's own error description, which arrives already translated. Keep the colon."
    },
    "Couldn’t transcribe the recording." : {
      "comment" : "Brief status line shown when speech recognition fails. The recording is what the user just said."
    },
    "Counting…" : {
      "comment" : "Placeholder caption in the Website data row on the Privacy settings page while the number of websites storing data is still being worked out. Real ellipsis."
    },
    "Current profile" : {
      "comment" : "Heading over the card describing the profile the browser is in right now."
    },
    "Currently %@." : {
      "comment" : "Caption naming the profile the browser would open in. %@ is a profile name."
    },
    "Custom" : {
      "comment" : "Option in the User agent segmented control on the Advanced settings page, meaning a user agent string you type yourself. An adjective; space in a segment is tight."
    },
    "Custom endpoint" : {
      "comment" : "Heading of the Settings page for adding your own model server; it reads “Edit endpoint” when an existing one is being changed. Sentence case."
    },
    "Custom tool set" : {
      "comment" : "Title of the row on the Tools settings page shown when the user changed the recommended tool selection."
    },
    "Customize Start Page" : {
      "comment" : "Tooltip on the Edit button in the bottom corner of the start page. Title case, no final period."
    },
    "Customize…" : {
      "comment" : "Button on the Tools row in Assistant settings: opens the Tools page."
    },
    "Cut" : {
      "comment" : "Standard macOS Edit menu item. Use the system's own wording. A verb."
    },
    "Dark" : {
      "comment" : "Option in the Theme segmented control on the Appearance settings page. Use the word macOS itself uses for Dark appearance; space in a segment is tight."
    },
    "Default" : {
      "comment" : "The (disabled) state of the button on the General settings page when Linen is already the system's default browser. A noun/adjective here, never a verb."
    },
    "Default browser" : {
      "comment" : "Heading of the section on the General settings page about which app opens links, and the title of that same row in Settings search. Sentence case; “default” is an adjective."
    },
    "Defaults for every website, and the ones you’ve changed." : {
      "comment" : "Caption under the Websites page title. Two halves: the settings that apply everywhere, and the list of individual websites given their own rules. Curly apostrophe."
    },
    "Delete" : {
      "comment" : "Standard macOS Edit menu item that deletes the selection. Use the system's own wording. A verb."
    },
    "Delete “%@”?" : {
      "comment" : "Heading of the delete confirmation for a sidebar folder or a profile. %@ is its name as the user typed it."
    },
    "Delete Folder" : {
      "comment" : "Verb on the destructive button of the delete-folder confirmation alert. Title Case, and it should read as the same command as the “Delete Folder…” menu item that raised the alert."
    },
    "Delete Folder…" : {
      "comment" : "Item in the context menu of a folder in the sidebar. The real ellipsis character (…) marks that it opens a confirmation first — keep it. Title Case."
    },
    "Delete Profile" : {

    },
    "Delete Profile…" : {
      "comment" : "Button that starts deleting a profile. The ellipsis says a question follows."
    },
    "deletions" : {
      "comment" : "Lowercase name of one category of assistant permission, inserted mid-sentence into a list under a website’s name, which reads roughly: Allowed without asking: purchases and deletions. Deliberately lowercase — do not capitalise it, even in languages that capitalise nouns. The capitalised label Deletions is a separate string."
    },
    "Deletions" : {
      "comment" : "Name of one of the four categories of sensitive action the assistant can be granted, in the Assistant permissions list on the Privacy settings page. A plural noun at the head of a row; a lowercase in-sentence variant exists separately."
    },
    "Denied" : {
      "comment" : "Caption under a permission's name in the site permission panel: the website was refused. Past participle, one word, tight."
    },
    "Deny" : {
      "comment" : "The saved policy that refuses a permission for a website; an option in the pop-up menus on the Websites settings page. A verb."
    },
    "Disable Voice" : {
      "comment" : "Command in the ⌘K palette that stops the assistant reading its replies aloud; its detail line reads “agent speech”. Title Case; pairs with “Enable Voice”."
    },
    "Disabled for this website" : {
      "comment" : "Status under Tracker Blocking in the website information popover when this website is exempt. Sentence fragment."
    },
    "Do you want to allow this page to open “%@”?" : {
      "comment" : "Heading of the alert asking whether a web page may launch another app on the Mac. %@ is that app's name as macOS displays it, inside curly quotes."
    },
    "Don’t Allow" : {
      "comment" : "Button in the permission panel that refuses the website's request, beside “Allow Once” and “Always Allow”. Keep the curly apostrophe. Title Case, and the three buttons share one narrow row."
    },
    "Done" : {
      "comment" : "Button that closes something the user has finished with: the Done button on the find bar and the one on the release notes sheet. Use the wording macOS uses on such buttons."
    },
    "Downloaded %@" : {
      "comment" : "Brief notice shown when a download finishes. %@ is the file's name. A past participle describing what happened, not a command."
    },
    "Downloading update" : {
      "comment" : "Status line in the update row on the About settings page while a release is being fetched."
    },
    "Downloading…" : {
      "comment" : "The update button's title while a release is being fetched; the button cannot be pressed in this state. Real ellipsis."
    },
    "Downloads" : {
      "comment" : "The downloads list, named in several places: a block on the start page, the tooltip on the sidebar's downloads button, the Downloads settings page in the sidebar, and the File menu item that opens it. A plural noun."
    },
    "Downloads — %lld in progress" : {
      "comment" : "Tooltip on the downloads button at the foot of the sidebar while transfers are running; %lld is how many are still going. Em dash separates the button's name from its state; the plain “Downloads” tooltip is a separate entry.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Downloads — %lld in progress"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Downloads — %lld in progress"
                }
              }
            }
          }
        }
      }
    },
    "Drag a profile to change the order." : {
      "comment" : "Footnote under the list of profiles in Settings, shown only when there is more than one, saying the rows can be reordered by dragging. The order is the one profiles appear in elsewhere in the app. Imperative with a final full stop."
    },
    "Drag to resize · double-click to reset" : {
      "comment" : "Tooltip on the draggable edge between the sidebar and the page. Two hints for the same edge, separated by an interpunct; “double-click” is the mouse gesture. Sentence case, no final period."
    },
    "Drop the page here" : {
      "comment" : "Caption in the empty region that opens when a page is dragged over the window; the pages already open have moved aside to make it. It names what a release there does. Sentence case, no final period."
    },
    "Duplicate Tab" : {
      "comment" : "Item in the context menu of a tab row in the sidebar; it opens a second tab on the same page. Verb plus object, Title Case."
    },
    "Each profile keeps its own sign-ins, history, tabs, and extensions." : {
      "comment" : "Caption under the Profiles page title, saying what a profile is."
    },
    "Edit" : {
      "comment" : "Used twice, always as a verb on a button: the button that opens a custom provider endpoint for changing, and the corner button that opens the start page's own editor."
    },
    "Edit endpoint" : {
      "comment" : "Heading of the Settings page for a custom model server when an existing one is being changed; it reads “Custom endpoint” when a new one is being added. Sentence case; “Edit” is a verb."
    },
    "Edit…" : {
      "comment" : "Button on the current profile’s card that opens that profile’s own page."
    },
    "empty" : {
      "comment" : "Badge shown in place of the tab count on a sidebar folder row that holds no tabs. A single adjective in a tiny capsule — deliberately lowercase and as short as possible; follow your own language's capitalisation rather than copying the English lowercase if that would look wrong."
    },
    "Enable Voice" : {
      "comment" : "Command in the ⌘K palette that turns the assistant's spoken replies back on; its detail line reads “agent speech”. Title Case; pairs with “Disable Voice”."
    },
    "Enabled for this website" : {
      "comment" : "Status under Tracker Blocking in the website information popover when protection applies to this website. Sentence fragment."
    },
    "End" : {
      "comment" : "Legend printed on a key cap in the shortcut recorder in Settings, where the user records the key that activates the assistant. Use the word your language's Apple keyboards print on that key; the cap is only a few characters wide. This one is the End navigation key, which jumps to the end."
    },
    "Endpoint" : {
      "comment" : "Title of the row in Settings > Provider showing which server a custom provider points at, and the title of that same row in Settings search. Technical term for a server address."
    },
    "Enter" : {
      "comment" : "Legend printed on a key cap in the shortcut recorder in Settings, where the user records the key that activates the assistant. Use the word your language's Apple keyboards print on that key; the cap is only a few characters wide. This one is the numeric keypad's Enter key, distinct from the main Return key, which has its own entry."
    },
    "Enter a name." : {
      "comment" : "Error shown under the custom endpoint form when the name field was left empty."
    },
    "Enter Full Screen" : {
      "comment" : "Standard macOS View menu item. Use the system's own wording. Title Case."
    },
    "Enter model ID…" : {
      "comment" : "Item at the bottom of the model pop-up menu in Settings > Provider that reveals a field for typing a model identifier by hand. “Model ID” is a technical identifier such as gpt-4o. Real ellipsis."
    },
    "Esc" : {
      "comment" : "Legend printed on a key cap in the shortcut recorder in Settings, where the user records the key that activates the assistant. Use the word your language's Apple keyboards print on that key; the cap is only a few characters wide. This one is the Escape key, abbreviated the way the key itself is printed."
    },
    "European models, with small and fast tiers." : {
      "comment" : "One-line description of the Mistral provider in the provider list in Settings, also shown in that row's tooltip. “Tiers” means the sizes of model the vendor offers."
    },
    "Every provider you’ve set up." : {
      "comment" : "Settings search description for the Providers section on the Assistant page. The page itself carries no caption there. A sentence fragment."
    },
    "Every website asks the first time." : {
      "comment" : "Description of the Ask option for a permission's default, meaning each website raises its own request. Third person singular."
    },
    "Every website with a rule of its own, and what that rule allows." : {
      "comment" : "Settings search description for the Websites you’ve changed list. A rule means any per-website setting: a permission, assistant access, keep loaded, or a tracker exception."
    },
    "every website you visit" : {
      "comment" : "The one entry that can appear in place of website names in the bulleted list of the extension install confirmation dialog, used when the extension can reach every website. It appears after a bullet character supplied by the app, so it is a phrase rather than a sentence and takes no full stop."
    },
    "Everything you’ve changed for this website." : {
      "comment" : "Caption under a single website's name at the top of its settings page, saying the page collects every rule that website carries. Curly apostrophe."
    },
    "Exit Full Screen" : {
      "comment" : "Command that leaves full screen; the same command reads “Enter Full Screen” while the window is not full screen. Use Apple’s own wording for the standard macOS command."
    },
    "Exit Picture in Picture" : {
      "comment" : "Tooltip on the same button while the video is already in Picture in Picture; pressing it returns the video to its tab. Title Case."
    },
    "Exit Split" : {
      "comment" : "Menu command that goes back to one page in the window. Neither page is closed: the one being read keeps the window and the other returns to being an ordinary sidebar row. Title Case."
    },
    "Expand Side Panel" : {
      "comment" : "Tooltip on the arrows button in the side panel’s tab strip while the panel is narrow. It makes the panel fill the window beside the sidebar. Pairs with “Collapse Side Panel”. Title Case."
    },
    "Experiments" : {
      "comment" : "Name of the Settings page that holds unfinished features, in the System group of the Settings sidebar, and the heading of that page. A noun, plural."
    },
    "Extension" : {
      "comment" : "Placeholder name used for an installed extension whose package declares no name of its own. A generic noun."
    },
    "Extension Options" : {
      "comment" : "Menu item that opens the settings page an extension provides for itself. It appears in the right-click menu of the extension's toolbar button and in the ellipsis menu of its row in Settings > Extensions, and only when that extension has such a page. Title Case."
    },
    "Extensions" : {
      "comment" : "The Extensions page in Settings: its name in the sidebar and the heading at the top of the page. A plural noun — browser extensions."
    },
    "Extra Large" : {
      "comment" : "Fourth and largest of the sizes in the lyrics text-size menu. Title Case."
    },
    "Failed" : {
      "comment" : "Small chip in the agent activity panel marking a task that ended in an error, next to the “Try Again” button. One word; very tight."
    },
    "fastest" : {
      "comment" : "Short note beside one suggested model in the model pop-up menu, marking it as the quickest to answer. Lowercase superlative, and the space is very tight."
    },
    "fastest · default" : {
      "comment" : "Short note beside one suggested model in the model pop-up menu, marking it as the quickest to answer and the one used unless another is picked. The middle dot separates the two words and should be kept. Lowercase, and the space is very tight."
    },
    "File" : {
      "comment" : "Title of the File menu in the menu bar. Use the standard macOS wording."
    },
    "Fill in search boxes and forms. Never passwords or payment details." : {
      "comment" : "Caption for the Type tool in assistant settings."
    },
    "Find" : {
      "comment" : "Title of the Find submenu inside the Edit menu. A noun here — the name of a group of find commands."
    },
    "Find a video and play it in the media player." : {
      "comment" : "Caption for the Play Videos tool in assistant settings."
    },
    "Find Another Match" : {
      "comment" : "Menu item under the ⋯ button of the lyrics view. It searches the lyrics library again for other entries for the same song. Title Case, as macOS menu items are."
    },
    "Find Next" : {
      "comment" : "Item in the Find submenu that jumps to the next match on the page. Title Case."
    },
    "Find Nike Pegasus 42" : {
      "comment" : "Label on one of three example prompt chips on the start page. “Nike Pegasus 42” is a product name — keep it unchanged. The prompt actually sent to the model is separate and stays in English."
    },
    "Find on page" : {
      "comment" : "Placeholder in the find bar's text field, the strip that opens over the page for finding text on it. Sentence case, narrow field."
    },
    "Find on Page…" : {
      "comment" : "Command palette entry for the ⌘F find bar. The ellipsis promises a field to type in. Title Case."
    },
    "Find Previous" : {
      "comment" : "Item in the Find submenu that jumps to the previous match on the page. Title Case."
    },
    "Find…" : {
      "comment" : "Item in the Find submenu that opens the find bar on the page. Title Case; the real ellipsis (…) means a field opens rather than something happening at once."
    },
    "Finding a video: %@…" : {
      "comment" : "Line in the assistant's live activity feed while it searches for a video. %@ is the topic the model was asked to find, in whatever words it used. Keep the colon; real ellipsis."
    },
    "Finding a video…" : {
      "comment" : "Line in the assistant’s live activity feed while it searches for a video whose topic is unknown. Present participle; real ellipsis."
    },
    "Finished on %@" : {
      "comment" : "Caption under the last snapshot in the agent activity column once the assistant has stopped. %@ is the page's host, e.g. example.com, or the fallback phrase “the research page”."
    },
    "Folder" : {
      "comment" : "Label of a chip in the Downloads view's toolbar that opens the download folder in the Finder. The noun, Title Case, in a narrow chip beside a folder glyph."
    },
    "Folder name" : {
      "comment" : "Placeholder in the inline rename field on a sidebar folder row. Sentence case, and very narrow — the field is only as wide as a sidebar row."
    },
    "Forever" : {
      "comment" : "Option in the Keep history for pop-up menu on the Privacy settings page, meaning history is never dropped. It completes “Keep history for …”."
    },
    "Forward" : {
      "comment" : "The command that goes forward one page in a tab, in the History menu. A direction, the opposite of Back — not the verb “to forward” something."
    },
    "Forward 15 seconds" : {
      "comment" : "Tooltip on the skip-forward button in the media player docked at the foot of the sidebar. The player jumps ahead exactly fifteen seconds; keep the number. “Forward” is directional, not the browser's Forward command."
    },
    "Frees memory when the Mac runs low. Tabs reload when you return to them." : {
      "comment" : "Caption under the “Sleep inactive tabs” switch on the General settings page, and the same wording in Settings search. Two short sentences: what it gains, then the reassurance that nothing is lost."
    },
    "Frees up space. Pages load more slowly the next time." : {
      "comment" : "Caption under Cached files on the Privacy settings page. Only the next visit to a website is slower."
    },
    "Frequently Visited" : {
      "comment" : "Title of the start page block showing the sites you open most. Title Case, matching the other block titles."
    },
    "Fwd Del" : {
      "comment" : "Legend printed on a key cap in the shortcut recorder in Settings, where the user records the key that activates the assistant. Use the word your language's Apple keyboards print on that key; the cap is only a few characters wide. This one is the forward delete key (delete to the right), abbreviated because the cap is tiny; the plain Delete key has its own entry."
    },
    "Gemini" : {
      "comment" : "Google's model family, shown as the API dialect a custom endpoint speaks. Product name — leave as is."
    },
    "Gemini, with thinking budget control." : {
      "comment" : "One-line description of the Google provider in the provider list in Settings, also shown in that row's tooltip. “Gemini” is a product name; “thinking budget” is Google's term for how much reasoning a request may spend."
    },
    "General" : {
      "comment" : "Name of the General page in the Settings sidebar and the heading at the top of that page."
    },
    "Get a Key" : {
      "comment" : "Button in the API key row in Settings > Provider that opens the provider's own website, where a key can be obtained. A command; “key” means API key."
    },
    "Glass transparency" : {

    },
    "go" : {
      "comment" : "Hint word printed beside a ↩ key cap under the address field, reading “↩ go”, shown when what is typed looks like an address: pressing Return loads it. One lowercase verb, tiny type."
    },
    "Go Back" : {
      "comment" : "Tool name in assistant settings: going back one page."
    },
    "Go to a web address in the research page." : {
      "comment" : "Caption for the Open Websites tool in assistant settings."
    },
    "Go to the Tab Playing This" : {
      "comment" : "Tooltip on the arrow in the media dock while another tab is providing the sound; clicking switches to that tab. “This” means what is currently playing. Title Case."
    },
    "Going back…" : {
      "comment" : "Line in the assistant's live activity feed while it goes back one page. Present participle; real ellipsis."
    },
    "Gray" : {
      "comment" : "Tooltip and accessibility label for one swatch in the colour row of a sidebar folder's context menu, the way the Finder labels its tag colours. A colour name on its own, Title Case; the swatch is 18 points across, so keep it to one word."
    },
    "Green" : {
      "comment" : "Tooltip and accessibility label for one swatch in the colour row of a sidebar folder's context menu, the way the Finder labels its tag colours. A colour name on its own, Title Case; the swatch is 18 points across, so keep it to one word."
    },
    "group related tabs into folders" : {

    },
    "Help" : {
      "comment" : "Title of the Help menu in the menu bar. Use the standard macOS wording."
    },
    "Hide Assistant Activity" : {
      "comment" : "View menu item that hides the panel showing what the assistant is doing; the same item reads “Show Assistant Activity” while the panel is hidden. Title Case."
    },
    "Hide Browser" : {
      "comment" : "View menu item that hides the web view; the same item reads “Show Browser” while it is hidden. Title Case."
    },
    "Hide Extension" : {
      "comment" : "Item in an extension's toolbar-button menu that takes its button off the toolbar; the same item reads “Show Extension” when the button is off. Title Case."
    },
    "Hide Linen" : {

    },
    "Hide Lyrics" : {
      "comment" : "Tooltip on the lyrics button in the media player while the lyrics are on screen. Pairs with “Show Lyrics”. Title Case."
    },
    "Hide Others" : {
      "comment" : "Standard macOS app-menu item that hides every other app. Use the system's own wording. Title Case."
    },
    "Hide Player" : {
      "comment" : "Tooltip on the small media button in the sidebar while the floating player is pulled out; clicking puts the player away again. Title Case."
    },
    "Hide Side Panel" : {
      "comment" : "Tooltip on the ✕ at the right of the side panel’s tab strip. It takes the whole panel off screen and keeps its tabs for next time. “Side Panel” is the right-hand one; the left is the Sidebar. Title Case."
    },
    "Hide Sidebar" : {
      "comment" : "View menu item that hides the tab sidebar; the same item reads “Show Sidebar” while it is hidden. Title Case."
    },
    "Hide Video" : {
      "comment" : "Tooltip on the eye button in the media dock; it hides the picture while playback and the controls carry on. Title Case, narrow dock."
    },
    "High" : {
      "comment" : "The strongest of the four Thinking levels in Settings > Provider (None, Low, Medium, High). It is one segment of a segmented control, so space is tight."
    },
    "History" : {
      "comment" : "Used in two places: the title of the History block on the start page, and the heading of the full browsing-history page. A noun."
    },
    "History and website data" : {
      "comment" : "Heading of the Privacy settings group holding how long history is kept and how much websites have stored. A noun phrase covering both, not an instruction."
    },
    "History, cookies, and cached files, over a chosen time range." : {
      "comment" : "Caption for the Clear browsing data row in Settings search results: what that section can delete and that a time span can be picked."
    },
    "hold" : {
      "comment" : "First word of the hint under the empty address field, which the user reads as one phrase: “hold ⌥Space to speak”, with the recorded shortcut drawn as key caps between this string and “to speak”. Imperative verb, deliberately lowercase, tiny type — the two halves must fit together as one sentence in your language."
    },
    "Hold %@ again to speak." : {
      "comment" : "Status message shown right after the user allows the microphone. %@ is the push-to-talk shortcut drawn as text, e.g. “⌥Space”. Again means the first press only asked for permission, so the key has to be held once more."
    },
    "Hold while speaking. Release to send." : {
      "comment" : "Caption under Push to talk in Settings > Voice, and the caption of that same row in Settings search. Both sentences are imperatives about holding a key down."
    },
    "Home" : {
      "comment" : "Legend printed on a key cap in the shortcut recorder in Settings, where the user records the key that activates the assistant. Use the word your language's Apple keyboards print on that key; the cap is only a few characters wide. This one is the Home navigation key, which jumps to the start — nothing to do with a home page."
    },
    "Homepage" : {
      "comment" : "Used twice: as an option in the New tab segmented control on the General settings page, and as the title of the row where the homepage address is typed. One word, as browsers write it."
    },
    "How long visited pages are kept." : {
      "comment" : "Caption for the Keep history for row in Settings search results."
    },
    "How many websites store data on this Mac." : {
      "comment" : "Caption for the Website data row in Settings search results — websites keeping cookies or other storage locally."
    },
    "How much reasoning effort the model spends." : {
      "comment" : "Caption for the Thinking row in Settings search results — how much the model deliberates before answering."
    },
    "Hundreds of models from every vendor, with a single key." : {
      "comment" : "One-line description of the OpenRouter provider in the provider picker. Key means API key. OpenRouter is a vendor name and is not in this string."
    },
    "Icons only" : {
      "comment" : "Title of the switch on the Appearance settings page that narrows the sidebar to favicons alone, and the title of that same row in Settings search. Sentence case."
    },
    "If no panel appeared, set it in System Settings under Desktop & Dock." : {
      "comment" : "Footnote shown after the app has asked to become the default browser. macOS, System Settings and Desktop & Dock are Apple’s names for the system, its settings app and one of its panes — use Apple’s own translations, since the user has to find them on screen. Panel means the confirmation window macOS puts up."
    },
    "ignore the cache" : {
      "comment" : "Caption under the Reload Page from Origin command in the command palette. Sentence fragment, lower case."
    },
    "Import" : {
      "comment" : "Used twice for bringing bookmarks in: the heading of the section on the General settings page (a noun there), and the confirming button in the import dialog and the file panel (a verb there)."
    },
    "Import Bookmarks" : {
      "comment" : "Heading of the confirmation dialog shown after the file is read and before anything is imported. Title Case."
    },
    "Import bookmarks from another browser, and open links from other apps in Linen." : {
      "comment" : "Caption under the Bring your bookmarks over heading on the last onboarding screen. It names the two things the card below it offers."
    },
    "Imported %@." : {
      "comment" : "Caption under the Bookmarks row after an import finishes. %@ is a count fragment such as “87 bookmarks”."
    },
    "Imported Bookmarks" : {
      "comment" : "Name of the sidebar folder that imported bookmarks go into. The user can rename the folder afterwards. Title Case."
    },
    "In sync" : {
      "comment" : "Label between the two timing buttons at the foot of the lyrics view, shown while the words have not been shifted against the sound. Clicking it puts a shift back to zero. Sentence case; the space is very tight."
    },
    "In System Settings, choose Linen as the default web browser." : {

    },
    "In the other browser, export your bookmarks to an HTML file first." : {
      "comment" : "Footnote under the Import section of the General settings page. It says what the user does in the other browser before choosing a file here."
    },
    "In use" : {
      "comment" : "Status shown beside the selected provider in Settings > Provider when it is ready and answering. The row is very narrow — keep it to two short words."
    },
    "In use since %@" : {
      "comment" : "How long a profile has been in use. %@ is a date, such as “March 4”."
    },
    "In use, allowed until you leave" : {
      "comment" : "Caption under a permission's name in the site permission panel: the site is using it right now, and the grant lasts only for this visit. Keep the comma, sentence case, one line."
    },
    "In use, always allowed" : {
      "comment" : "Caption under a permission's name in the site permission panel: two clauses about one permission — the site is using it right now, and the grant is permanent. Keep the comma, sentence case, one line."
    },
    "Inexpensive models that think before answering." : {
      "comment" : "One-line description of the DeepSeek provider in the provider list in Settings, also shown in that row's tooltip. A fragment with no verb; keep it terse."
    },
    "Inspect" : {
      "comment" : "Label on the disclosure control of a step row in the agent activity panel when the step has output but no links; it reveals what the step returned. Verb, narrow column; alternates with “%lld links”."
    },
    "Install" : {
      "comment" : "The confirming button in the sheet that asks whether to install an extension, and the button Linen adds to an extension's page in the Chrome Web Store. A verb (a command). Not the update button: that is `update.banner.install`."
    },
    "Install “%@”?" : {
      "comment" : "Heading of the sheet asking whether to install an extension. %@ is the extension's own name, taken from its package and never translated, inside curly quotes."
    },
    "Install this extension in Linen" : {

    },
    "Installed" : {
      "comment" : "Marker shown in place of an Install button on a Chrome Web Store page for an extension Linen already has. A past participle describing a state, not a command. The Release Notes page shows the same word under its own key, releaseNotes.installedBadge."
    },
    "Installed extensions" : {
      "comment" : "Title of the Extensions list row in Settings search results. Sentence case; “installed” is an adjective."
    },
    "Installed version %@" : {
      "comment" : "Update status shown when nothing is happening. %@ is the version number of the running app, e.g. 1.4.2."
    },
    "Installing update" : {
      "comment" : "Status line in the update row on the About settings page while a downloaded release is being installed."
    },
    "Installing…" : {
      "comment" : "Used twice, as a present participle with a real ellipsis: the update button's title while an update is being installed, and the state shown beside an extension while it is being installed."
    },
    "Instrumental" : {
      "comment" : "Shown in the middle of the lyrics view for a track that has no words. One word, sentence case."
    },
    "Issued to: %@" : {

    },
    "It is removed from every profile, along with its settings and data." : {
      "comment" : "Message in the dialog that confirms removing an extension, warning that the removal is not limited to the profile the person is in. Full sentence."
    },
    "Its %lld pages of history are removed, along with the start page tiles. Other profiles are not affected." : {
      "comment" : "Message in the dialog that confirms clearing one profile’s history. %lld is the number of pages in that profile’s history.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Its %lld page of history is removed, along with the start page tiles. Other profiles are not affected."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Its %lld pages of history are removed, along with the start page tiles. Other profiles are not affected."
                }
              }
            }
          }
        }
      }
    },
    "Its %lld pages of history, tabs, and sign-ins are removed from this Mac. Downloaded files stay in the Downloads folder." : {
      "comment" : "Message in the dialog that confirms deleting a profile. %lld is the number of pages in that profile’s history.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Its %lld page of history, tabs, and sign-ins are removed from this Mac. Downloaded files stay in the Downloads folder."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Its %lld pages of history, tabs, and sign-ins are removed from this Mac. Downloaded files stay in the Downloads folder."
                }
              }
            }
          }
        }
      }
    },
    "Its %lld tabs stay in the sidebar." : {
      "comment" : "Reassuring detail line of that same delete-folder alert; %lld is how many tabs the folder holds. “Its” refers to the folder, and the point is that the tabs are not closed — they move back out into the sidebar list. Full sentence with a period.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Its %lld tab stays in the sidebar."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Its %lld tabs stay in the sidebar."
                }
              }
            }
          }
        }
      }
    },
    "Its name and URL are removed. The server itself isn’t affected." : {
      "comment" : "Explanatory text in the confirmation sheet for removing a custom provider endpoint. “Its” refers to that endpoint; the machine it points at is untouched. Curly apostrophe."
    },
    "JavaScript" : {
      "comment" : "Title of the switch on the Websites settings page, and the title of that same row in Settings search. Name of the technology — leave as is."
    },
    "just now" : {
      "comment" : "Relative time on a task card and in the agent activity panel, used for anything less than 45 seconds old; older ages are written by the system in the reader's own locale. Lowercase fragment on a metadata line."
    },
    "Keep history for" : {
      "comment" : "Title of the row on the Privacy settings page whose pop-up menu holds A day, A week, A month, A year and Forever — the title and the chosen value read as one phrase, so leave room for the value to follow. Sentence case."
    },
    "Keep loaded" : {
      "comment" : "Row title on a single website's settings page. On means the website is never unloaded to reclaim memory, so returning to its tab does not reload it."
    },
    "Keep Website Loaded" : {

    },
    "kept loaded" : {
      "comment" : "Fragment in the one-line summary under a website, meaning it is never unloaded to reclaim memory. Lower case: joined with other fragments."
    },
    "Kept separate from other profiles" : {
      "comment" : "Heading over the list of what one profile keeps to itself."
    },
    "key %u" : {
      "comment" : "Fallback legend on a key cap in the shortcut recorder for a key that has no name and prints no character. %u is the raw macOS key code, a bare number; only the word “key” is translated. Very tight."
    },
    "Key from %@" : {
      "comment" : "Settings → Assistant. %@ is an environment variable name, e.g. \"OPENAI_API_KEY\". Shown when the key comes from the environment rather than the Keychain."
    },
    "Key saved" : {
      "comment" : "Settings → Assistant. Shown under a provider name when its API key is in the Keychain."
    },
    "Keys are saved to your Keychain." : {
      "comment" : "Settings → Assistant → Add a provider. Footnote under the providers that need an API key. “Keychain” is the macOS password store — use Apple’s own name for it."
    },
    "Large" : {
      "comment" : "Third of the four sizes in the lyrics text-size menu (Small, Regular, Large, Extra Large). Title Case."
    },
    "Last 4 weeks" : {
      "comment" : "Option in the Time range pop-up menu on the Privacy settings page, saying how far back to clear. A lowercase in-sentence variant exists as a separate entry."
    },
    "Last 7 days" : {
      "comment" : "Option in the Time range pop-up menu on the Privacy settings page, saying how far back to clear. A lowercase in-sentence variant exists as a separate entry."
    },
    "Last 24 hours" : {
      "comment" : "Option in the Time range pop-up menu on the Privacy settings page, saying how far back to clear. A lowercase in-sentence variant exists as a separate entry."
    },
    "Last hour" : {
      "comment" : "Option in the Time range pop-up menu on the Privacy settings page, saying how far back to clear — the past hour. A lowercase in-sentence variant exists as a separate entry."
    },
    "Last used %@" : {
      "comment" : "When a profile was last open, shown in the profile list. %@ is a phrase such as “2 days ago”. A fragment, not a sentence."
    },
    "Leave empty to use the system default." : {
      "comment" : "Caption under the custom user agent field on the Advanced settings page."
    },
    "Leave Private Browsing" : {

    },
    "left ⇧" : {
      "comment" : "Name of one physical modifier key in the shortcut recorder in Settings, where the two sides of the keyboard have to be told apart because the assistant is activated by holding one of them. Only the side word is translated — the symbol is the glyph macOS prints on the key, so keep it exactly and keep it beside the word. Very tight: this is a key cap. The glyph is Shift."
    },
    "left ⌃" : {
      "comment" : "Name of one physical modifier key in the shortcut recorder in Settings, where the two sides of the keyboard have to be told apart because the assistant is activated by holding one of them. Only the side word is translated — the symbol is the glyph macOS prints on the key, so keep it exactly and keep it beside the word. Very tight: this is a key cap. The glyph is Control."
    },
    "left ⌘" : {
      "comment" : "Name of one physical modifier key in the shortcut recorder in Settings, where the two sides of the keyboard have to be told apart because the assistant is activated by holding one of them. Only the side word is translated — the symbol is the glyph macOS prints on the key, so keep it exactly and keep it beside the word. Very tight: this is a key cap. The glyph is Command."
    },
    "left ⌥" : {
      "comment" : "Name of one physical modifier key in the shortcut recorder in Settings, where the two sides of the keyboard have to be told apart. Only the side word is translated — the symbol is the glyph macOS prints on the key, so keep it exactly and keep it beside the word. Very tight: this is a key cap. The glyph is Option."
    },
    "Less transparent" : {

    },
    "Library" : {
      "comment" : "Heading of the commands in the ⌘K command palette that open one of the browser’s own pages or panels: history, downloads, settings, extensions. Title Case."
    },
    "License" : {
      "comment" : "Button at the end of a package's row on the About settings page. It opens the full license text of that package. A noun, not a verb — and very tight, because it sits in a small chip."
    },
    "Light" : {
      "comment" : "Option in the Theme segmented control on the Appearance settings page. Use the word macOS itself uses for Light appearance; space in a segment is tight."
    },
    "Light, dark, or match your Mac." : {

    },
    "Linen" : {

    },
    "Linen blocks third-party requests to known advertising, analytics, session-recording, social-pixel, and fingerprinting domains." : {

    },
    "Linen can’t confirm that this certificate belongs to %@. Somebody may be impersonating the website." : {

    },
    "Linen can’t search with this URL. DuckDuckGo is answering instead." : {
      "comment" : "Caption under the custom search engine fields when the URL template the user typed cannot be used, so the default engine answers searches until it is fixed."
    },
    "Linen is using %@ instead." : {
      "comment" : "Settings → Assistant. %@ is the provider name of the stand-in, e.g. \"Apple Intelligence\". Caption shown when the chosen provider is not ready and another one serves replies. Linen is the application name and is never translated."
    },
    "Linen is your default browser." : {
      "comment" : "Caption under the Open links from other apps row, shown once Linen is the default browser. The alternative caption, shown while it is not, is Linen isn’t your default browser. Linen is the application name and is never translated."
    },
    "Linen isn’t your default browser." : {
      "comment" : "Caption under the Open links from other apps row, shown while Linen is not the default browser. The alternative caption, shown once it is, is Linen is your default browser. Linen is the application name and is never translated; curly apostrophe."
    },
    "Linen looks up lyrics on LRCLIB. Only the song and artist names leave your Mac, and never from a private tab." : {
      "comment" : "Caption under the “Show lyrics” switch on the General settings page, and the same sentence in settings search. It says what the feature does and what leaves the Mac, since nothing else asks the user first. LRCLIB is the name of the website and is never translated. Two full sentences."
    },
    "Linen opens in" : {
      "comment" : "Heading on Profiles over the choice of which profile Linen starts in."
    },
    "Linen opens in the same profile every time." : {
      "comment" : "Caption for the choice that pins the browser to one profile at launch."
    },
    "Linen updates to preview builds, ahead of the release." : {
      "comment" : "Caption under the Update channel menu in Settings > About while Preview is chosen. Describes the chosen channel, not the other one. Must stay on one line — about 57 characters."
    },
    "Linen updates when a version is ready for everyone." : {
      "comment" : "Caption under the Update channel menu in Settings > About while Release is chosen. Describes the chosen channel, not the other one. Must stay on one line — about 57 characters."
    },
    "Linen uses the system user agent. Changing this can break websites." : {

    },
    "Link Copied" : {
      "comment" : "Brief notice confirming the page's address is now on the clipboard. Title Case, as the app's other short notices are; a past participle, not a command."
    },
    "Links Copied" : {
      "comment" : "Passing notice under the address field after several web addresses are copied at once. Plural of Link Copied. Title case."
    },
    "Links you click still open." : {
      "comment" : "Caption under Block pop-ups in Websites settings, and its settings search caption."
    },
    "Liquid Glass" : {

    },
    "Liquid Glass transparency" : {

    },
    "Listening…" : {
      "comment" : "Line shown in the address field while the microphone is on and nothing has been heard yet; the user's own words replace it as they speak. Real ellipsis character (…) — keep it, not three periods."
    },
    "Live" : {
      "comment" : "Badge beside the play button in the media dock for a live stream, which has no timeline to scrub — the red-dot “live” of web video players. Also serves as the badge's accessibility label. Adjective, extremely tight."
    },
    "Load a model, then start the local server from LM Studio’s Developer tab." : {
      "comment" : "Setup hint shown under the LM Studio provider in Settings > Provider. “LM Studio” is the app's name and “Developer” is a tab inside it — leave both as is. Two imperatives; curly apostrophe."
    },
    "Local models with a GUI, on port 1234." : {
      "comment" : "One-line description of the LM Studio provider in the provider list in Settings, also shown in that row's tooltip. “GUI” means a graphical interface, and the port number is literal — keep it."
    },
    "local storage" : {
      "comment" : "The same kind of data named partway through a sentence, joined with others into a summary under a website's name. Lower case; never shown alone."
    },
    "Local storage" : {
      "comment" : "One kind of data a website stores, covering the web storage and database APIs together. Shown beside a website's name in the Website data list."
    },
    "location" : {
      "comment" : "Lowercase name of one website permission, inserted mid-sentence into the confirmation: Are you sure you want to remove the location setting for every website? Deliberately lowercase — do not capitalise it, even in languages that capitalise nouns. The capitalised row label Location is a separate string."
    },
    "Location" : {
      "comment" : "Name of the location permission: a row on the Websites settings page and a label in the permission badge in the toolbar. Means the Mac's geographic location."
    },
    "Look things up with the search engine." : {
      "comment" : "Caption for the Search the Web tool in assistant settings."
    },
    "Looking for lyrics…" : {
      "comment" : "Shown with a spinner in the lyrics view while the words are being looked up. Present participle with a real ellipsis."
    },
    "Looking for related tabs…" : {

    },
    "Looking for the notes…" : {
      "comment" : "Line on the Release Notes page while the app fetches the notes from GitHub. Ends with an ellipsis character, not three full stops."
    },
    "Low" : {
      "comment" : "The second of the four Thinking levels in Settings > Provider (None, Low, Medium, High). One segment of a segmented control, so space is tight."
    },
    "Lyrics" : {
      "comment" : "Heading of the settings group on the General page that holds the “Show lyrics” switch. A noun, plural in English."
    },
    "Lyrics are off" : {
      "comment" : "Title shown in the middle of the Lyrics panel when the setting is off. A statement of fact, sentence case with no final full stop, as empty-state titles are."
    },
    "Lyrics from LRCLIB" : {
      "comment" : "Credit line at the foot of the lyrics view, naming the website the words came from. LRCLIB is a name and is never translated. Not a sentence; very small type."
    },
    "lyrics.offset.seconds" : {
      "comment" : "Reading at the foot of the lyrics view once the user has shifted the words against the sound, for example “+0.50 s”. %@ is an already-formatted number carrying its own plus or minus sign. “s” is the symbol for seconds; keep it short.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%@ s"
          }
        }
      }
    },
    "Manage profiles" : {
      "comment" : "Subtitle under the open profile's name at the top of the Settings sidebar, saying that clicking it opens the Profiles page. A profile is a separate set of cookies, history and tabs. Sentence case, no final full stop, and short enough for a narrow sidebar."
    },
    "Manage Profiles…" : {

    },
    "Manage your downloads" : {
      "comment" : "One line in the bulleted list of what an extension will be able to do, in the install confirmation sheet. It completes “It will also be able to:”."
    },
    "Manage your other extensions" : {
      "comment" : "One line in the bulleted list of what an extension will be able to do, in the install confirmation sheet. It completes “It will also be able to:”."
    },
    "Media" : {
      "comment" : "Section title on the Tools settings page."
    },
    "Medium" : {
      "comment" : "The third of the four Thinking levels in Settings > Provider (None, Low, Medium, High). One segment of a segmented control, so space is tight."
    },
    "Menu commands already use ⌘ shortcuts. Hold ⌥, ⌃ or ⇧ instead." : {
      "comment" : "Warning shown under the shortcut recorder in Settings > Voice when the user records a shortcut that uses the Command key. The menu bar claims those, so the recorder refuses them. The four glyphs are the ones macOS prints on the modifier keys — Command, Option, Control and Shift — and stay exactly as they are. Two sentences: the reason, then what to press instead."
    },
    "menu.option.labelAndDetail" : {
      "comment" : "One line of an open pop-up menu: %1$@ is the choice itself (often a model or endpoint name), %2$@ a short note about it. Only the separator is ours to change.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ — %2$@"
          }
        }
      }
    },
    "microphone" : {
      "comment" : "Lowercase name of one website permission, inserted mid-sentence into the confirmation: Are you sure you want to remove the microphone setting for every website? Deliberately lowercase — do not capitalise it, even in languages that capitalise nouns. The capitalised row label Microphone is a separate string."
    },
    "Microphone" : {
      "comment" : "Name of the microphone permission: a row on the Websites settings page and a label in the permission badge in the toolbar."
    },
    "Minimize" : {
      "comment" : "Standard macOS Window menu item. Use the system's own wording. A verb."
    },
    "Model" : {
      "comment" : "Title of the row in Settings > Provider that chooses which model answers, and the title of that same row in Settings search. A noun — an AI model."
    },
    "model-id" : {
      "comment" : "Placeholder text inside the field where a model identifier is typed by hand, showing the shape of the expected value rather than naming anything. Written in the lowercase hyphenated style of a technical identifier."
    },
    "model, voice, API key" : {
      "comment" : "Detail line under the Settings command in the ⌘K palette, listing what Settings contains. Lowercase caption, comma-separated; “API key” is the technical term and stays in that form."
    },
    "money transfers" : {
      "comment" : "Lowercase name of one category of assistant permission, inserted mid-sentence into a list under a website’s name, which reads roughly: Allowed without asking: purchases and money transfers. Deliberately lowercase — do not capitalise it, even in languages that capitalise nouns. The capitalised label Money transfers is a separate string."
    },
    "Money transfers" : {
      "comment" : "Name of one of the four categories of sensitive action the assistant can be granted, in the Assistant permissions list on the Privacy settings page. A plural noun at the head of a row; a lowercase in-sentence variant exists separately."
    },
    "More Extensions" : {
      "comment" : "Tooltip on the toolbar button that reveals extensions whose buttons are not on the bar. Title Case."
    },
    "More Extensions — %lld don’t fit in this window" : {
      "comment" : "The same toolbar tooltip when some extensions are hidden for lack of room. %lld is how many are hidden. Em dash and curly apostrophe.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "More Extensions — %lld doesn’t fit in this window"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "More Extensions — %lld don’t fit in this window"
                }
              }
            }
          }
        }
      }
    },
    "More Options" : {
      "comment" : "Tooltip on the ellipsis button at the end of an extension's row in Settings > Extensions. It opens a menu holding the extension's own options page, where it has one, and Remove Extension. Title Case."
    },
    "More tools than recommended" : {
      "comment" : "Title of the warning row on the Tools settings page."
    },
    "More transparent" : {

    },
    "most capable" : {
      "comment" : "Short note beside one suggested model in the model pop-up menu, marking it as the strongest of the group. Lowercase, and the space is very tight."
    },
    "Move between the tabs in the conversation." : {
      "comment" : "Caption for the Switch Tabs tool in assistant settings."
    },
    "Move Bookmark to This Page" : {
      "comment" : "Item in the context menu of a tab row that already has a bookmarked page: it hands the tab's single anchor to the page now open, replacing the old one. Use the same noun for “bookmark” as in “Bookmark This Page”. Title Case."
    },
    "Move Linen to the Applications folder?" : {
      "comment" : "Title of the alert Linen shows at launch when it runs from anywhere other than an Applications folder. Sentence case, and the question mark is the only closing punctuation macOS dialog titles take."
    },
    "Move the video into Picture in Picture and back." : {
      "comment" : "Caption for the Picture in Picture tool in assistant settings."
    },
    "Move to Applications" : {
      "comment" : "Default button of that alert. It puts Linen in the Applications folder and reopens it from there. Title Case; use the system name of the folder."
    },
    "Move to Folder" : {
      "comment" : "Title of the submenu in a sidebar context menu that lists the folders the tab, or the whole selection, can be filed into. Title Case."
    },
    "Move up or down a page." : {
      "comment" : "Caption for the Scroll tool in assistant settings."
    },
    "moves money" : {
      "comment" : "Clause that completes the sentence This … and usually can’t be undone. in the dialog asking the user to approve an action the assistant wants to take. Lowercase, third person singular, and the implied subject is the action being approved."
    },
    "Mute" : {
      "comment" : "Tooltip on the speaker button in the media player docked at the foot of the sidebar; it silences playback. Verb, one word; pairs with “Unmute”."
    },
    "Mute Tab" : {
      "comment" : "Tooltip on the small speaker button inside a tab row in the sidebar; it silences that tab. Title Case, and the row is narrow — keep it to two short words."
    },
    "Mute This Tab" : {
      "comment" : "Tooltip on the speaker button in the toolbar, which acts on the tab currently on screen. “This Tab” distinguishes it from the sidebar's per-row control. Title Case."
    },
    "Muted" : {
      "comment" : "Option in the Autoplay segmented control on the Websites settings page: video may start on its own but sound waits for a click. A past participle describing the media; space in a segment is tight."
    },
    "My server" : {
      "comment" : "Placeholder text in the Name field of the custom endpoint form — an example of what to type, not a value the app uses."
    },
    "Name" : {
      "comment" : "Used twice as a field label: the title of the name field on the custom endpoint page, and the placeholder in the field that names a custom search engine. A noun."
    },
    "Name and appearance" : {
      "comment" : "Heading over the name field, color swatches and symbol grid of one profile."
    },
    "Narrow the sidebar to its icons." : {
      "comment" : "Description of the Icons only switch, shown only in the Settings search results, meaning the sidebar keeps each row's symbol and drops its text. Imperative with a final full stop."
    },
    "Needs a key" : {
      "comment" : "Settings → Assistant → a provider page. Readiness status when the provider has no API key."
    },
    "Needs a server you run" : {
      "comment" : "Settings → Assistant → Add a provider. Section heading over providers that need a server the user starts themselves."
    },
    "Needs an API key" : {
      "comment" : "Settings → Assistant → Add a provider. Section heading over providers set up by entering an API key."
    },
    "Never" : {
      "comment" : "Option in the Autoplay segmented control on the Websites settings page: nothing starts playing on its own."
    },
    "Never opened" : {
      "comment" : "Summary of a profile that has never been used, shown in place of its counts."
    },
    "New Folder" : {
      "comment" : "The name a newly created sidebar folder carries until it is renamed. Title Case, the way macOS names new folders."
    },
    "New Folder…" : {
      "comment" : "Last item of that “Move to Folder” submenu; it makes a new folder with the rows the menu acts on — the one tab, or every selected row — in it. The real ellipsis character marks that a name is asked for — keep it. Title Case."
    },
    "New Profile" : {

    },
    "New Tab" : {
      "comment" : "The command that opens a tab, in several places: a File menu item, the row at the top of the sidebar, an action in the command palette and the sidebar's tooltip. Title Case, as commands are."
    },
    "New Tab (⌘T)" : {
      "comment" : "Tooltip on the New Tab row, shown only when the sidebar is collapsed to icons and the row has no words of its own. ⌘T is the keyboard shortcut — keyboard symbols, keep exactly. Title Case."
    },
    "New tabs" : {
      "comment" : "Heading over the choice of what a new tab opens with."
    },
    "New tabs open with this page." : {
      "comment" : "Caption under Homepage on the General settings page, and the caption of that same row in Settings search."
    },
    "Next (⌘G)" : {
      "comment" : "Tooltip on the down-chevron in the find bar, which moves to the next match on the page. ⌘G is the keyboard shortcut — keyboard symbols, keep exactly, including the parentheses."
    },
    "No %@ key yet, using Apple Intelligence" : {
      "comment" : "Status message when the chosen provider has no API key stored and Linen falls back to the on-device model. %@ is the provider's name, e.g. OpenAI; “Apple Intelligence” is Apple's product name — leave as is."
    },
    "No Access" : {

    },
    "No app can open this link." : {
      "comment" : "Heading of the alert shown when nothing installed on the Mac handles the kind of link that was clicked."
    },
    "No bookmarks in this file." : {
      "comment" : "Caption under the Bookmarks row when the chosen file was read but held no web pages."
    },
    "No connection to check" : {
      "comment" : "Label used where the address bar's security glyph has nothing to report — no page is loaded. Sentence case, no final period."
    },
    "No data stored" : {
      "comment" : "Shown under “Size on disk” when a profile is holding nothing."
    },
    "No extensions installed yet." : {
      "comment" : "Empty state for extensions, used both as the caption under the Extensions heading and as the placeholder inside the empty list."
    },
    "No history" : {
      "comment" : "Shown under “History” when a profile has visited no pages."
    },
    "No key yet" : {
      "comment" : "Settings → Assistant. Shown under a provider name when it has no API key."
    },
    "No known tracker domains were found." : {

    },
    "No lyrics found" : {
      "comment" : "Title of the empty state in the lyrics view when nothing matched the track. Sentence case with no final full stop."
    },
    "No matches" : {
      "comment" : "Shown in place of the website-data list when the filter text matches no website in it."
    },
    "No notes are published yet." : {
      "comment" : "Line on the Release Notes page when GitHub returns no releases at all. A Try Again button sits below it. Not an error: the fetch may simply have failed."
    },
    "No notes for this release." : {
      "comment" : "Shown in the release notes sheet when the update carries no description."
    },
    "No pages match “%@”." : {
      "comment" : "Empty state in the History view when a search returns nothing. %@ is the text the user typed into the search field. Keep the curly quotation marks and the final period."
    },
    "No pages recorded yet." : {
      "comment" : "Caption under Keep history for on the Privacy settings page when no pages have been visited yet."
    },
    "No pages visited yet." : {
      "comment" : "Empty state in the History view when there is no history at all. Full sentence with a period, sentence case."
    },
    "No provider is ready" : {
      "comment" : "Settings → Assistant. Title of the status shown when no provider can serve replies at all."
    },
    "No recent downloads." : {
      "comment" : "Empty state of the downloads list, shown in the downloads popover and on the Downloads settings page."
    },
    "No related tabs to group." : {
      "comment" : "Status line shown after the assistant looked at the open tabs and found no group worth making."
    },
    "No room" : {
      "comment" : "Shown in place of a Pin button beside an extension in the overflow list, meaning the toolbar is too narrow to hold its button. A very small label in a narrow row — keep it to two short words."
    },
    "No server answers to that address. Check the spelling." : {
      "comment" : "Explanatory text on the error page shown when a website's address cannot be resolved; the headline above it is a separate entry."
    },
    "No tabs" : {
      "comment" : "Shown where a tab count would be, when a profile has none. A fragment, not a sentence."
    },
    "No tasks yet" : {
      "comment" : "Title shown in the middle of the Activity panel before the assistant has done anything on this page. Sentence case with no final full stop."
    },
    "No webpage is open yet." : {

    },
    "No website data" : {
      "comment" : "Shown in place of the list when no website holds anything locally. A statement, not an error."
    },
    "No website matches what you typed." : {
      "comment" : "Guidance under No matches, shown when a search filters the website data list to nothing."
    },
    "No website may ask." : {
      "comment" : "Description of the Deny option for a permission's default, meaning requests are refused without the person seeing them."
    },
    "No website stores data on this Mac." : {
      "comment" : "Guidance under No website data. Singular no website rather than a count of zero, which reads as a measurement failure. Website is one word."
    },
    "No website stores data." : {
      "comment" : "Caption under the Website data row when no website holds cookies or storage on this Mac. Singular no website rather than a count of zero, which reads as a measurement failure. Website is one word."
    },
    "No websites changed" : {
      "comment" : "Shown in place of the website list when no website has a rule of its own. A statement, not an error."
    },
    "No websites yet" : {
      "comment" : "Shown in place of the list on one permission's page when no website has asked for it yet."
    },
    "None" : {
      "comment" : "The first of the four Thinking levels in Settings > Provider (None, Low, Medium, High), meaning no reasoning effort at all. One segment of a segmented control, so space is tight."
    },
    "None installed" : {
      "comment" : "Shown under “Extensions” when a profile has none."
    },
    "Not enough loose tabs to organize." : {

    },
    "Not found" : {
      "comment" : "Inline notice in the find bar when the typed text appears nowhere on the page. Sentence case, very tight — it sits between the field and the arrow buttons."
    },
    "Not in use right now." : {

    },
    "Not Now" : {
      "comment" : "Button that refuses the move in that alert. Linen does not ask again. Title Case, and Apple’s own wording for a refusal that is not final."
    },
    "Not responding" : {
      "comment" : "Settings → Assistant → a provider page. Readiness status when a local server did not answer."
    },
    "Nothing always-allowed" : {
      "comment" : "Title of the placeholder row in the Assistant permissions section of the Privacy settings page when no website has a standing grant. “Always Allow” is the button that creates one, so keep the wording recognisably the same as that button's."
    },
    "Nothing in this profile is saved." : {
      "comment" : "Shown instead of a date when the browser is in Private Browsing."
    },
    "Nothing installed on this Mac handles “%@” links." : {
      "comment" : "Explanatory text in the alert shown when no app can open a link. %@ is the link's scheme, e.g. mailto or tel, inside curly quotes — a technical token, never translated."
    },
    "nothing is kept" : {
      "comment" : "Caption under the Private Browsing command in the command palette: no history, cookie or cache survives the session. Sentence fragment, lower case."
    },
    "Nothing is playing" : {
      "comment" : "Title of the empty state in the lyrics view when the media player holds no track. Sentence case with no final full stop."
    },
    "Nothing matches." : {
      "comment" : "Shown in the Settings sidebar when a search finds no settings and no pages."
    },
    "Nothing on LRCLIB matches this track." : {
      "comment" : "Caption under “No lyrics found” in the Lyrics panel. LRCLIB is the name of the website the words come from and is never translated. Full sentence."
    },
    "Nothing plays until you press play." : {
      "comment" : "Caption under Autoplay on the Websites settings page when it is set to Never. “Press play” means clicking the play button on the page."
    },
    "notifications" : {
      "comment" : "Lowercase name of one website permission, inserted mid-sentence into the confirmation: Are you sure you want to remove the notifications setting for every website? Deliberately lowercase — do not capitalise it, even in languages that capitalise nouns. The capitalised row label Notifications is a separate string."
    },
    "Notifications" : {
      "comment" : "Name of one of the four website permissions, used as a row title in the Websites settings page and in the site-permission badge. Title case; a separate lowercase form exists for use inside a sentence."
    },
    "now" : {
      "comment" : "Relative time on a task card, shown while the task is still running; every other age is written by the system in the reader's own locale. Lowercase fragment on a metadata line, very tight."
    },
    "Now Playing" : {
      "comment" : "Fallback title in the media dock when the page never said what is playing. Apple's own term for this line — use the wording your platform uses. Title Case, one narrow line."
    },
    "OK" : {
      "comment" : "Button that simply dismisses an alert, used both for a web page’s own JavaScript alert and for the warning that no app on the Mac handles a link type. It confirms nothing beyond having read the message."
    },
    "on %@" : {
      "comment" : "Fragment inserted into the dialog asking the user to approve an action the assistant wants to take, giving the place: The assistant wants to click “Pay now” on example.com. %@ is the website’s hostname. The alternative fragment, used when there is no hostname, is on this page."
    },
    "On an extension’s page in the store, an Install button appears in the toolbar." : {
      "comment" : "Explanatory footnote under the Extensions section in Settings. The store is the Chrome Web Store, and Install names the button that appears in the browser toolbar, so keep it matching the translation of that button. Curly apostrophe."
    },
    "On Device" : {
      "comment" : "Chip above the Apple Intelligence card on the model-choice onboarding screen, saying where that model runs. It pairs with “API key required” on the card beside it: both state a plain fact about the choice rather than recommending it. Title Case, and only a few characters wide."
    },
    "On the Page" : {
      "comment" : "Section title on the Tools settings page: tools that act on the current web page."
    },
    "on this Mac" : {
      "comment" : "Short phrase shown where a provider’s server address would otherwise be, for a model that runs on the user’s own computer; it appears after a dash in a tooltip, so it is a fragment rather than a sentence and stays lowercase."
    },
    "on this page" : {
      "comment" : "Fragment inserted into the dialog asking the user to approve an action the assistant wants to take, used when the website’s name is unknown: The assistant wants to click “Pay now” on this page. The alternative fragment, which names the site, is on %@."
    },
    "on-device" : {
      "comment" : "Small tag beside a provider in Settings, naming the kind of connection it uses — in this case a model running on the Mac itself rather than over the network. Deliberately lowercase and technical; the other tags in the same place are responses and OpenAI compatible. Very tight space."
    },
    "Open" : {
      "comment" : "Button beside a finished download in Settings that opens the downloaded file. Imperative verb, not the adjective, and space is tight next to a file name."
    },
    "Open a new tab when you ask for one." : {
      "comment" : "Caption for the Open Tabs tool in assistant settings."
    },
    "Open a profile, or change its name, symbol, and color." : {
      "comment" : "Settings search result caption for the profile list. Symbol means the small picture on the profile's tile. Full sentence."
    },
    "open a second page below this one" : {
      "comment" : "Caption under the Split Down command in the command palette. Sentence fragment, lower case."
    },
    "open a second page beside this one" : {
      "comment" : "Caption under the Split Right command in the command palette. Sentence fragment, lower case."
    },
    "Open Beside Current Page" : {
      "comment" : "Context-menu command on a sidebar row that shows that tab next to the page already open, as two panes. Title Case. Current page means the one on screen now."
    },
    "Open Frame in New Tab" : {
      "comment" : "Item in the web page’s right-click menu. Frame means an HTML frame within the page. Title Case."
    },
    "Open Image in New Tab" : {
      "comment" : "Item in the web page’s right-click menu. Title Case."
    },
    "Open Link in New Tab" : {
      "comment" : "Item in the web page’s right-click menu. Title Case."
    },
    "Open links from other apps" : {
      "comment" : "Title of the Settings row that makes Linen the default browser. Open is a verb and links is its object: the row is about which app opens links clicked in other applications. Sentence case."
    },
    "Open links from other apps in Linen." : {

    },
    "Open Location…" : {
      "comment" : "Menu bar command under File that puts the cursor in the address bar; shortcut ⌘L. Title Case and a real ellipsis character. Use established platform terminology."
    },
    "Open models served fast enough for voice." : {
      "comment" : "One-line description of the Groq provider in the provider picker. Open models means open-weight AI models, and voice refers to spoken conversation with the assistant, where the reply has to arrive quickly."
    },
    "Open Profile" : {
      "comment" : "Button that switches the browser to the profile whose page is open."
    },
    "Open Tabs" : {
      "comment" : "Section heading in the ⌘K palette over the tabs already open. “Open” is an adjective describing the tabs, not a command to open them. Title Case."
    },
    "Open the project page" : {
      "comment" : "Tooltip on the small button beside a package on the About settings page; it opens that package's own repository in a new tab. Sentence case, no final full stop."
    },
    "Open this link in the task’s tab" : {
      "comment" : "Tooltip on a link row inside an expanded step of the agent activity panel; clicking loads that link in the tab the assistant's task belongs to. Sentence case; keep the curly apostrophe."
    },
    "Open Video in New Tab" : {
      "comment" : "Item in the web page’s right-click menu. Title Case."
    },
    "Open website" : {
      "comment" : "Detail line under the top row of the address bar results when what was typed is an address; pressing Return loads it. Verb phrase in sentence case."
    },
    "Open website in a new tab" : {
      "comment" : "Detail line under the second row of the ⌘K palette results when what was typed is an address; ⇧Return, or a Command-click, loads it beside the current page instead of in it. Verb phrase in sentence case."
    },
    "Open Websites" : {
      "comment" : "Tool name in assistant settings: opening a web address."
    },
    "OpenAI compatible" : {
      "comment" : "Small tag beside a user-added endpoint in Settings, naming which API dialect the server speaks. OpenAI is a vendor name — leave as is; only the word compatible is translatable. Very tight space."
    },
    "OpenAI-compatible endpoint" : {
      "comment" : "Placeholder description shown for a user-added provider before its address has been saved. OpenAI is a vendor name — leave as is."
    },
    "OpenAI-compatible endpoint at %@" : {
      "comment" : "Description the app writes for a user-added provider once its address is saved; it appears under the provider’s name in the provider list. %@ is the hostname taken from the URL the user typed, for example localhost or api.example.com. OpenAI is a vendor name — leave as is."
    },
    "Opened Tab" : {
      "comment" : "Detail suffix on an address bar result row that stands for an already-open tab; it is joined after the host with “ • ”, giving “example.com • Opened Tab”. Adjective plus noun, Title Case, very tight."
    },
    "Opening %@…" : {
      "comment" : "Status line under the assistant’s reply while it loads a page. %@ is the website’s hostname, for example example.com, or the separate phrase the page when the address has no hostname. Real ellipsis."
    },
    "Opening a new tab…" : {
      "comment" : "Status line under the assistant’s reply while it opens a new browser tab. Real ellipsis."
    },
    "Opens the project’s issue page." : {
      "comment" : "Caption under Show report button in Appearance settings, and its settings search caption."
    },
    "Orange" : {
      "comment" : "Tooltip and accessibility label for one swatch in the colour row of a sidebar folder's context menu, the way the Finder labels its tag colours. A colour name on its own, Title Case; the swatch is 18 points across, so keep it to one word."
    },
    "Organize" : {

    },
    "Organize Tabs…" : {

    },
    "Organize your tabs into folders?" : {

    },
    "Organizing tabs needs a model: add a provider key or enable Apple Intelligence." : {

    },
    "Other Pane" : {
      "comment" : "Menu command that moves focus to the second of two pages shown at once, so the address bar and Find follow it. Title Case. A noun phrase naming where focus goes, not a verb."
    },
    "Other profiles" : {
      "comment" : "Heading over the list of every profile except the one in use, on the Profiles page. Plural noun phrase."
    },
    "Other websites" : {
      "comment" : "Label of the row that sets the answer for every website not listed individually below it, in the Websites permissions section. A noun phrase, not a heading."
    },
    "Page" : {
      "comment" : "Heading of the commands that act on the page being read in the ⌘K command palette: reload, find, print, zoom. Title Case, singular noun."
    },
    "Page Down" : {
      "comment" : "Legend printed on a key cap in the shortcut recorder in Settings, where the user records the key that activates the assistant. Use the word your language's Apple keyboards print on that key; the cap is only a few characters wide. This one is the Page Down navigation key."
    },
    "Page Up" : {
      "comment" : "Legend printed on a key cap in the shortcut recorder in Settings, where the user records the key that activates the assistant. Use the word your language's Apple keyboards print on that key; the cap is only a few characters wide. This one is the Page Up navigation key."
    },
    "Page zoom" : {
      "comment" : "Title of the Appearance settings row that sets the default zoom level for web pages, and the same wording in the Settings search index. Sentence case; page means a web page."
    },
    "Pages" : {
      "comment" : "Heading over the group of Settings pages matched by a search, shown beside a separate group of individual settings. Plural noun meaning the pages of the Settings window. Narrow column, keep it short."
    },
    "Pages of history" : {
      "comment" : "Label under a number, counting the pages a profile has visited."
    },
    "Parts of this page aren’t encrypted" : {
      "comment" : "Label for the address bar's warning glyph on a mixed-content page: the page is served over https but pulls some content over http. Sentence case, no final period; keep the curly apostrophe."
    },
    "Password" : {
      "comment" : "Placeholder text inside the password field of the dialog a website shows when it asks for HTTP authentication."
    },
    "Paste" : {
      "comment" : "Standard macOS Edit menu command, and the label of a button that pastes clipboard text into the ask field. Imperative verb. Use Apple’s own wording for the system Edit menu command."
    },
    "Paste and Go" : {
      "comment" : "Item in the address field's context menu, shown when the clipboard holds an address: it pastes and loads the page in one step. Title Case."
    },
    "Paste and Match Style" : {
      "comment" : "Standard macOS Edit menu command that pastes text with the surrounding formatting. Use Apple’s own wording for it in the target language."
    },
    "Paste and Search" : {
      "comment" : "The same context-menu item when the clipboard holds words rather than an address: it pastes and runs a web search. Title Case."
    },
    "Paste your key…" : {
      "comment" : "Placeholder text inside the secure field where the user pastes an API key. Key means API key. Real ellipsis."
    },
    "Pause" : {
      "comment" : "Tooltip on the play/pause button in the media player docked at the foot of the sidebar, while something is playing. Verb; keep it to one word."
    },
    "Pause and Close" : {
      "comment" : "Tooltip on the close button in the media dock. It pauses what is playing and puts the player away; the tab it was playing from stays open. Title Case."
    },
    "Pause the video and close the media player." : {
      "comment" : "Caption for the Close the Player tool in assistant settings."
    },
    "permanently deletes something" : {
      "comment" : "Clause that completes the sentence This … and usually can’t be undone. in the dialog asking the user to approve an action the assistant wants to take. Lowercase, third person singular, and the implied subject is the action being approved."
    },
    "Permissions" : {
      "comment" : "Title of the Websites settings section listing what each website may use (location, camera, microphone, notifications), and the same word in the Settings search index. Plural noun."
    },
    "Permissions for this website" : {
      "comment" : "Tooltip on the permission badge in the address bar when a site has a standing allow or deny on record; clicking opens the permission panel. Sentence case; use “website” rather than “site”."
    },
    "Personal" : {

    },
    "Pick an option in a dropdown menu." : {
      "comment" : "Caption for the Choose From Menus tool in assistant settings."
    },
    "Picture in Picture" : {
      "comment" : "Tooltip on the button that floats the video in a system Picture in Picture window. It is used twice: beside the address field, left of the speaker, for the tab you are looking at, and on the media player in the sidebar. Apple feature name; use the platform glossary. Title Case."
    },
    "Pin" : {
      "comment" : "Small button in the extensions overflow popover that puts the extension’s button back on the toolbar. Imperative verb, in the sense of fixing something in place. Very tight space — a chip only a few characters wide."
    },
    "Pink" : {
      "comment" : "Tooltip and accessibility label for one swatch in the colour row of a sidebar folder's context menu, the way the Finder labels its tag colours. A colour name on its own, Title Case; the swatch is 18 points across, so keep it to one word."
    },
    "Place Side by Side" : {
      "comment" : "Menu command that rearranges two stacked pages into two columns. Title Case. Its opposite is Stack Pages, and the menu shows whichever one is available."
    },
    "Plans a little before acting. The best balance for voice." : {
      "comment" : "Caption under the Thinking segmented control in Settings > Provider, describing the Low level of reasoning effort. “Voice” means talking to the assistant out loud."
    },
    "Play" : {
      "comment" : "Tooltip on the play/pause button in the media player docked at the foot of the sidebar, while playback is stopped. Verb; the dock is narrow, so keep it to one word."
    },
    "Play chill lofi" : {
      "comment" : "Label on one of three example prompt chips on the start page. “lofi” is the music genre (lo-fi) — keep a form your readers will recognise. The prompt actually sent to the model is separate and stays in English."
    },
    "Play Videos" : {
      "comment" : "Tool name in assistant settings: finding and playing a video."
    },
    "posting and sending" : {
      "comment" : "Lowercase name of one category of assistant permission, inserted mid-sentence into a list under a website’s name, which reads roughly: Allowed without asking: deletions and posting and sending. Deliberately lowercase — do not capitalise it, even in languages that capitalise nouns. The capitalised label Posting and sending is a separate string."
    },
    "Posting and sending" : {
      "comment" : "Title Case label of one category of sensitive action in the assistant-permissions list in Settings, covering publishing content and sending messages. A lowercase mid-sentence form of the same phrase exists separately."
    },
    "posts or sends something in your name" : {
      "comment" : "Clause that completes the sentence This … and usually can’t be undone. in the dialog asking the user to approve an action the assistant wants to take. Lowercase, third person singular; the implied subject is the action, and in your name means as though the user had done it."
    },
    "Preparing update" : {
      "comment" : "Status line under the Software Update heading in Settings while the downloaded update is being unpacked. Sentence case."
    },
    "Preparing…" : {

    },
    "Press a shortcut. Press Escape to cancel." : {
      "comment" : "Instruction shown under the keyboard-shortcut field while it is listening for a keystroke. Escape is the name of the key — use the name printed on keyboards in the target language."
    },
    "Press buttons and follow links." : {
      "comment" : "Caption for the Click tool in assistant settings."
    },
    "Press shortcut" : {
      "comment" : "Placeholder inside the keyboard-shortcut field while it is waiting for a keystroke. Press is a verb. Very tight space — the field is only as wide as a couple of key caps."
    },
    "Preview" : {
      "comment" : "One choice in the Update channel menu in Settings > About: builds made from the newest change, before a release. A noun. Its twin is “Release”. One word, it sits in a narrow menu."
    },
    "Previous (⇧⌘G)" : {
      "comment" : "Tooltip on the up-chevron in the find bar, which moves to the previous match on the page. ⇧⌘G is the keyboard shortcut — keyboard symbols, keep exactly, including the parentheses."
    },
    "previous flagship" : {
      "comment" : "Short note beside one suggested model in the model pop-up menu, marking it as the vendor’s previous top model. Lowercase, and the space is very tight."
    },
    "Print Page…" : {
      "comment" : "Command in the page’s right-click menu, below Save Page As…. It opens the macOS print panel. The ellipsis says that a panel opens; keep it. Title Case."
    },
    "Print…" : {
      "comment" : "Menu bar command under File, shortcut ⌘P. Title Case with a real ellipsis, which promises that a dialog follows. Use Apple’s own wording for the system Print command."
    },
    "Privacy" : {
      "comment" : "Title of the Privacy page in Settings and its name in the Settings sidebar. Single-word noun in a narrow sidebar row, so keep it short."
    },
    "Private Browsing" : {

    },
    "Private, offline, and no API key. Best for short answers." : {
      "comment" : "Caption inside the Apple Intelligence card on the model-choice onboarding screen. Three properties, then what the model suits. It is set against the caption on the card beside it, which ends “Best for longer, complex tasks”, so keep that contrast. Two short lines."
    },
    "Profile" : {
      "comment" : "Label of the menu that picks which profile the browser opens in."
    },
    "Profile — %@" : {

    },
    "Profiles" : {

    },
    "Provider error %lld: %@" : {
      "comment" : "Error message when the AI provider’s server rejects a request. %lld is the HTTP status code, for example 404 or 500. %@ is the error text the server itself returned, which arrives untranslated, or the separate word unknown when the response carried no message."
    },
    "Providers" : {
      "comment" : "Settings → Assistant. Section heading over the providers the user has already set up."
    },
    "Pulled locally" : {
      "comment" : "Heading over the group of models already downloaded onto this Mac, in the model pop-up menu. Pulled is Ollama’s word for downloading a model; locally means onto this computer. The alternative heading for a remote provider is Available to this key."
    },
    "purchases" : {
      "comment" : "Lowercase name of one category of assistant permission, inserted mid-sentence into a list under a website’s name, which reads roughly: Allowed without asking: purchases and deletions. Deliberately lowercase — do not capitalise it, even in languages that capitalise nouns. The capitalised label Purchases is a separate string."
    },
    "Purchases" : {
      "comment" : "Title Case label of one category of sensitive action in the assistant-permissions list in Settings, meaning buying things. A lowercase mid-sentence form of the same word exists separately."
    },
    "Purple" : {
      "comment" : "Tooltip and accessibility label for one swatch in the colour row of a sidebar folder's context menu, the way the Finder labels its tag colours. A colour name on its own, Title Case; the swatch is 18 points across, so keep it to one word."
    },
    "Push to talk" : {
      "comment" : "Title of the Voice settings row for the key held down while speaking, and the same wording in the Settings search index. The established name for hold-to-speak; sentence case."
    },
    "Put appearance, search, privacy, websites, and downloads back to their defaults." : {
      "comment" : "Description of the Reset settings row, shown only in the Settings search results. The five nouns name Settings pages, so translate them the same way their page titles are translated. Imperative with a final full stop."
    },
    "Questions go to %@. Links still open normally." : {
      "comment" : "Caption under the Ask instead of search row. %@ is the configured assistant's display name, for example OpenAI (gpt-5.6-luna), and is not translated."
    },
    "Questions go to the assistant. Links still open normally." : {
      "comment" : "Settings search caption for Ask instead of search. The page caption names the chosen model instead."
    },
    "Quit Linen" : {

    },
    "Read a page’s text and controls." : {
      "comment" : "Caption for the Read Pages tool in assistant settings."
    },
    "Read aloud" : {
      "comment" : "Title of the Voice settings row that has answers spoken by the Mac, and the same wording in the Settings search index. Read is a verb here. Sentence case."
    },
    "Read and change cookies, including sign-in cookies" : {
      "comment" : "One bullet in the list of what a browser extension will be able to do, shown in the install confirmation dialog. It follows the line It will also be able to:, so it is a bare verb phrase and takes no final full stop."
    },
    "Read and change your data on:" : {
      "comment" : "Heading line above a bulleted list of website names in the extension install confirmation dialog. The trailing colon is part of the string and must stay, since the hostnames follow directly beneath it."
    },
    "Read Only" : {

    },
    "Read Only lets the assistant see page text on %@. Allow Control also lets it click, type, scroll, and navigate. Password and payment fields stay blocked." : {

    },
    "Read Pages" : {
      "comment" : "Tool name in assistant settings: reading a page’s text and controls."
    },
    "Read your browsing history" : {
      "comment" : "One bullet in the list of what a browser extension will be able to do, shown in the install confirmation dialog. It follows the line It will also be able to:, so it is a bare verb phrase and takes no final full stop."
    },
    "Read your clipboard" : {
      "comment" : "One bullet in the list of what a browser extension will be able to do, shown in the install confirmation dialog. It follows the line It will also be able to:, so it is a bare verb phrase and takes no final full stop."
    },
    "Reading the page…" : {
      "comment" : "Status line under the assistant’s reply while it reads the contents of the current web page. Real ellipsis."
    },
    "Ready" : {
      "comment" : "Settings → Assistant → a provider page. Readiness status when the provider can answer."
    },
    "Ready to install" : {
      "comment" : "Status line under the Software Update heading in Settings once the update has been downloaded and unpacked. An adjective phrase describing the update, not an instruction."
    },
    "Recent" : {
      "comment" : "Title of the Downloads settings section listing recently downloaded files. A short heading beside an icon, so keep it brief."
    },
    "Recent downloads" : {
      "comment" : "Sentence case title of the same downloads list as it is indexed for the Settings search. Downloads means downloaded files."
    },
    "Recent files" : {
      "comment" : "Description of the Downloads section in the start page editor. No final full stop."
    },
    "Recent Tasks" : {
      "comment" : "Title Case name of the start page section listing earlier requests made to the assistant, shown where the start page’s sections can be turned on and off. Tasks means things the user asked the assistant to do."
    },
    "Recently Visited" : {
      "comment" : "Section heading in the ⌘K palette over pages taken from history. Title Case."
    },
    "Recently visited pages" : {
      "comment" : "Description of the History section in the start page editor. Pages means web pages. No final full stop."
    },
    "Red" : {
      "comment" : "Tooltip and accessibility label for one swatch in the colour row of a sidebar folder's context menu, the way the Finder labels its tag colours. A colour name on its own, Title Case; the swatch is 18 points across, so keep it to one word."
    },
    "Redo" : {
      "comment" : "Standard macOS Edit menu command, shortcut ⇧⌘Z. Use Apple’s own wording for it in the target language."
    },
    "Regular" : {
      "comment" : "Second of the four sizes in the lyrics text-size menu, and the one Linen starts with. Use the word macOS itself uses for a default type size. Title Case."
    },
    "Release" : {
      "comment" : "One choice in the Update channel menu in Settings > About: the normal, numbered versions. A noun, not the verb “to release”. Its twin is “Preview”. One word, it sits in a narrow menu."
    },
    "Release Notes" : {
      "comment" : "Name of the page that lists what changed in this version. It appears in two places: the heading with the back arrow at the top of the page, and the command palette. Title Case, because a macOS menu item is title case. Use the same wording in both, and in “Release Notes…”."
    },
    "Release Notes…" : {
      "comment" : "The Linen menu item that opens the release notes page. It carries the trailing ellipsis every item in that menu uses to say it opens something else, next to “Check for Updates…” and “Settings…”. Keep the wording the same as “Release Notes”."
    },
    "releaseNotes.installedBadge" : {
      "comment" : "Badge beside the version you are running, in the list of every release on the Release Notes page. Shares its English text with the Chrome Web Store marker of the same name, which is why it carries a key of its own.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Installed"
          }
        }
      }
    },
    "Reload" : {
      "comment" : "Tooltip on the circular-arrow button in the toolbar, which loads the current page again. Verb; alternates with “Stop” while a page is still loading. Title Case, very tight."
    },
    "Reload Page" : {
      "comment" : "Menu bar command under View, shortcut ⌘R, and the same command in the site controls menu and at the top of the page’s right-click menu. Title Case and established platform terminology."
    },
    "Reload Page from Origin" : {
      "comment" : "Menu bar command under View, shortcut ⇧⌘R, which reloads while ignoring the cache. Origin means the web server the page came from. Title Case and established platform terminology."
    },
    "Remote model" : {

    },
    "Remove" : {
      "comment" : "Button beside a user-added endpoint in the Provider settings that deletes it from the list. Imperative verb; it opens a confirmation first."
    },
    "Remove “%@”?" : {
      "comment" : "Heading of a confirmation sheet used in two places: removing a custom provider endpoint, and removing an installed extension. %@ is that endpoint's or extension's own name, inside curly quotes and never translated."
    },
    "Remove %@" : {
      "comment" : "Tooltip on the small close button in the corner of a frequently-visited site tile on the start page; it hides that tile. %@ is the site's own title, taken from the website — never translated."
    },
    "Remove All" : {
      "comment" : "Destructive confirming button inside the dialog that clears one permission setting for every website at once. Imperative verb plus its object; matches the wording of the button that opened the dialog."
    },
    "Remove All…" : {
      "comment" : "Button in the Websites permissions list that opens the confirmation dialog for clearing one permission setting for every website. The real ellipsis is the promise that a dialog follows, so keep it."
    },
    "Remove Bookmark" : {
      "comment" : "Command that removes the tab's bookmarked page. Four surfaces share it: the context menu of a tab row, the minus button on a bookmarked row, the toolbar button while the bookmarked page is on screen, and the search palette. Title Case."
    },
    "Remove Endpoint" : {
      "comment" : "Destructive confirming button inside the dialog that deletes a user-added provider endpoint. Title Case, imperative verb plus its object."
    },
    "Remove Extension" : {
      "comment" : "Destructive command that uninstalls a browser extension. It is the confirming button in the dialog, the command in the right-click menu of the extension's toolbar button, and the last item in the ellipsis menu of its row in Settings > Extensions. Title Case, imperative verb plus object."
    },
    "Remove from Folder" : {
      "comment" : "Item in a sidebar context menu, shown only when the tab, or a row of the selection, is inside a folder; it moves the rows back out into the main list without closing them. Title Case."
    },
    "Remove from History" : {
      "comment" : "Tooltip on the close button of a history row on the start page; it deletes that one entry from history. Title Case."
    },
    "Remove from List" : {
      "comment" : "Tooltip on the close button of a download row, on the start page and in the Downloads view. It forgets the row only — the downloaded file stays on disk — so avoid a verb that sounds like deleting the file. Title Case."
    },
    "Remove Key" : {
      "comment" : "Destructive confirming button inside the dialog that deletes the stored API key. Key means API key. Title Case, imperative verb plus its object."
    },
    "Remove Task" : {
      "comment" : "Tooltip on the close button of a card in Recent Tasks on the start page; it forgets that one turn the agent ran. Title Case."
    },
    "Remove the %@ key?" : {
      "comment" : "Heading of the confirmation sheet for deleting a stored API key. %@ is the provider's name, e.g. OpenAI or Anthropic — vendor names, leave as is; “key” means API key."
    },
    "Remove the %@ setting for every website?" : {
      "comment" : "Heading of the confirmation sheet for clearing one saved permission from all websites, on the Websites settings page. %@ is the permission named mid-sentence and deliberately lowercase — “location”, “camera”, “microphone” or “notifications”, each a separate catalog entry."
    },
    "Remove the data stored by “%@”?" : {
      "comment" : "Title of the confirmation for clearing one website's stored data. %@ is the website's own name, for example example.com, and is never translated. Keep the curly quotation marks around it."
    },
    "Remove the data stored by every website?" : {
      "comment" : "Title of the confirmation for clearing the stored data of every website in the list."
    },
    "Remove This Page" : {
      "comment" : "Context-menu command on one page of several shown at once. That page leaves the arrangement and goes back to being an ordinary sidebar row; the others keep the window. Title Case."
    },
    "Remove…" : {
      "comment" : "Button on the Website Data settings page that opens the confirmation dialog for deleting a website’s stored data. Imperative verb; the real ellipsis is the promise that a dialog follows, so keep it."
    },
    "Rename" : {
      "comment" : "First item in the context menu of a sidebar folder; it starts editing the folder's name inline. Verb, Title Case."
    },
    "Reopen Last Closed Tab" : {
      "comment" : "Menu bar command under File, shortcut ⇧⌘T. Title Case and established browser terminology."
    },
    "Repeat a recent task" : {
      "comment" : "Description of the Recent Tasks section in the start page editor. No final full stop."
    },
    "Replace %@ key" : {
      "comment" : "Heading of the small popover where an API key is typed, shown when a key is already stored. %@ is the provider’s brand name, for example OpenAI, Anthropic or Ollama — leave the inserted name as is. Key means API key."
    },
    "Replies are generated by AI and can contain mistakes. Check important info." : {
      "comment" : "AI disclosure shown under the provider card in Settings. Keep the tone plain and factual."
    },
    "Report an issue" : {

    },
    "Reported by %@ for the selected model." : {
      "comment" : "Caption under the Context window row. %@ is the provider name, e.g. Ollama."
    },
    "Research" : {
      "comment" : "Section title on the Tools settings page."
    },
    "Reset" : {
      "comment" : "Used twice: as the label of a button that puts the download folder back to its default, and as the title of the Settings section for restoring defaults. It has to work both as an imperative verb on a button and as a short section heading."
    },
    "Reset all settings?" : {
      "comment" : "Heading of the confirmation sheet for Reset settings on the Advanced settings page."
    },
    "Reset settings" : {
      "comment" : "Sentence case title of the row that offers to restore defaults, and the same wording in the Settings search index. Reset is a verb, settings its object."
    },
    "Reset Settings" : {
      "comment" : "Destructive confirming button inside the dialog that restores the default settings. Title Case, imperative verb plus its object; Settings is the app’s own Settings window."
    },
    "Reset the settings for “%@”?" : {
      "comment" : "Title of the confirmation for clearing one website's rules. %@ is the website's own address, for example example.com, and is never translated. Keep the curly quotation marks around it."
    },
    "Reset the Timing" : {
      "comment" : "Tooltip on the offset reading at the foot of the lyrics view. Clicking it puts the shift between the words and the sound back to zero. Title Case."
    },
    "Reset This Website…" : {
      "comment" : "Button that clears every rule saved for one website. Title Case as a button naming a command, and the ellipsis is there because a confirmation follows."
    },
    "Reset to Default" : {
      "comment" : "Tooltip on the small arrow button that puts a keyboard shortcut back to the one the app ships with. Default is a noun here, meaning the original value."
    },
    "Reset Website" : {
      "comment" : "The confirming button in that dialog. Title Case, and it repeats the verb from the question rather than saying OK."
    },
    "Reset Zoom" : {

    },
    "Reset…" : {
      "comment" : "Button that opens the confirmation dialog for restoring default settings. Imperative verb; the real ellipsis is the promise that a dialog follows, so keep it."
    },
    "responses" : {
      "comment" : "Small tag beside a user-added endpoint in Settings, naming which API dialect it speaks — here OpenAI’s Responses API. A technical API name rather than an ordinary word, so leave it as is. Very tight space."
    },
    "Restore %lld removed websites" : {
      "comment" : "Button at the foot of the start page's Edit popover that brings back website tiles the user dismissed. %lld is how many are currently hidden. Sentence case; the catalogue carries the plural forms, so do not hand-roll a singular.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Restore %lld removed website"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Restore %lld removed websites"
                }
              }
            }
          }
        }
      }
    },
    "Resume" : {

    },
    "Retry" : {
      "comment" : "Button shown in place of the Install button after an extension failed to install, offering another attempt. Imperative verb. Tight space next to a warning icon."
    },
    "Return" : {
      "comment" : "Legend printed on a key cap in the shortcut recorder in Settings, where the user records the key that activates the assistant. Use the word your language's Apple keyboards print on that key; the cap is only a few characters wide. This one is the main Return key, distinct from the numeric keypad's Enter, which has its own entry."
    },
    "Return to the previous page." : {
      "comment" : "Caption for the Go Back tool in assistant settings."
    },
    "Revoke" : {
      "comment" : "Destructive confirming button inside the dialog that withdraws the assistant’s saved permissions for one website. Imperative verb, in the sense of taking a permission back."
    },
    "Revoke All" : {
      "comment" : "Button that withdraws every saved assistant permission for every website, and the destructive confirming button inside the dialog it opens. Imperative verb plus its object."
    },
    "Revoke every saved permission?" : {
      "comment" : "Heading of the confirmation sheet that clears every standing “Always Allow” the assistant was given, in the Assistant permissions section of the Privacy settings page."
    },
    "Revoke the permissions for “%@”?" : {
      "comment" : "Heading of the confirmation sheet that clears the assistant's standing permissions for one website, in the Assistant permissions list. %@ is the website's hostname, e.g. example.com, inside curly quotes."
    },
    "Revoke…" : {
      "comment" : "Button on one website’s row that opens the dialog for withdrawing the assistant permissions saved for that site. The real ellipsis is the promise that a dialog follows, so keep it."
    },
    "right ⇧" : {
      "comment" : "Name of one physical modifier key in the shortcut recorder in Settings, where the two sides of the keyboard have to be told apart because the assistant is activated by holding one of them. Only the side word is translated — the symbol is the glyph macOS prints on the key, so keep it exactly and keep it beside the word. Very tight: this is a key cap. The glyph is Shift."
    },
    "right ⌃" : {
      "comment" : "Name of one physical modifier key in the shortcut recorder in Settings, where the two sides of the keyboard have to be told apart because the assistant is activated by holding one of them. Only the side word is translated — the symbol is the glyph macOS prints on the key, so keep it exactly and keep it beside the word. Very tight: this is a key cap. The glyph is Control."
    },
    "right ⌘" : {
      "comment" : "Name of one physical modifier key in the shortcut recorder in Settings, where the two sides of the keyboard have to be told apart because the assistant is activated by holding one of them. Only the side word is translated — the symbol is the glyph macOS prints on the key, so keep it exactly and keep it beside the word. Very tight: this is a key cap. The glyph is Command."
    },
    "right ⌥" : {
      "comment" : "Name of one physical modifier key in the shortcut recorder in Settings, where the two sides of the keyboard have to be told apart. Only the side word is translated — the symbol is the glyph macOS prints on the key, so keep it exactly and keep it beside the word. Very tight: this is a key cap. The glyph is Option."
    },
    "Route your traffic through a proxy" : {
      "comment" : "One bullet in the list of what a browser extension will be able to do, shown in the install confirmation dialog. Traffic means the user’s network traffic. It follows the line It will also be able to:, so it is a bare verb phrase and takes no final full stop."
    },
    "Running" : {
      "comment" : "Status word on a recent-task card on the start page, next to a coloured dot and followed by “ · ” and a relative time. Says the task is still going."
    },
    "Running, but no models are loaded yet." : {
      "comment" : "Status line under a locally hosted provider such as Ollama in the Provider settings: the server answered, but it is serving no models. Running describes the server, not the user."
    },
    "Runs on this Mac. No API key required." : {
      "comment" : "One-line description of the Apple Intelligence provider in the provider picker. The implied subject of Runs is the model. Apple Intelligence is a product name and is not in this string."
    },
    "Safari" : {
      "comment" : "Apple’s browser, offered as one choice of what Linen reports itself as to websites. Product name — leave exactly as is."
    },
    "Save" : {
      "comment" : "Button that stores the typed API key, and the button that saves an edited user-added endpoint. Imperative verb."
    },
    "Save File" : {
      "comment" : "Title of the macOS save panel that appears when a download needs a destination. Use Apple’s standard wording for a save panel title in the target language."
    },
    "Save files to" : {
      "comment" : "Title of the Downloads settings row whose control names the folder, so it reads as an unfinished sentence completed by the folder shown beside it. Save is a verb; sentence case."
    },
    "Save Page As" : {
      "comment" : "Title of the macOS save panel that the Save Page As… command opens. It carries no ellipsis, because the panel is already open."
    },
    "Save Page As…" : {
      "comment" : "Command in the page’s right-click menu. It opens the macOS save panel, where the page is saved as a web archive file. The ellipsis says that a panel opens; keep it. Title Case."
    },
    "Saved in your Keychain." : {
      "comment" : "Caption under the API key row when a key is stored but cannot be shown in masked form. The implied subject is the key. Keychain is Apple’s password store — use Apple’s own name for it."
    },
    "Scroll" : {
      "comment" : "Tool name in assistant settings: scrolling a web page."
    },
    "Scrolling…" : {
      "comment" : "Status line under the assistant’s reply while it scrolls the web page. Real ellipsis."
    },
    "search" : {
      "comment" : "Hint word printed beside a ↩ key cap under the address field, reading “↩ search”, shown when what is typed is not an address: pressing Return searches the web for it. One lowercase verb, tiny type."
    },
    "Search" : {
      "comment" : "Title of the General settings section grouping the search engine rows. A noun heading beside an icon, not a button or a verb."
    },
    "Search anything" : {
      "comment" : "Large heading above the ask field on the start page in the normal case. Imperative invitation, sentence case; alternates with “Ask anything”."
    },
    "Search engine" : {
      "comment" : "Title of the General settings row that chooses which search engine is used, and the same wording in the Settings search index. A noun phrase, not an instruction. Sentence case."
    },
    "Search Everything (⌘K)" : {
      "comment" : "Tooltip on the magnifier button in the sidebar header, which opens the command palette. ⌘K is the keyboard shortcut — keyboard symbols, keep exactly as written. Title Case."
    },
    "Search Everything…" : {
      "comment" : "Menu bar command under File, shortcut ⌘K, which opens the command palette that searches tabs, history and settings at once. Title Case with a real ellipsis, which promises that something opens."
    },
    "Search history" : {
      "comment" : "Placeholder in the search field of the History view. “Search” is the verb and “history” its object. Sentence case, narrow field."
    },
    "Search or ask" : {
      "comment" : "Accessibility label for the combined search and assistant field on the start page. Keep it short and name both functions."
    },
    "Search settings" : {
      "comment" : "Placeholder inside the search field at the top of the Settings sidebar. Search is the verb and settings its object, meaning the settings of this app. Narrow field, so keep it short."
    },
    "Search suggestions" : {
      "comment" : "Title of the row that turns on completions offered by the search engine while typing, and the same wording in the Settings search index. A noun phrase. Sentence case."
    },
    "Search tabs, history, actions, or ask" : {
      "comment" : "Placeholder in the ⌘K palette's field when the browser is set to agent-only input, so there is no web search to offer. “Search” governs tabs, history and actions; “ask” means put the question to the assistant. Sentence case."
    },
    "Search tabs, history, actions, or the web" : {
      "comment" : "Placeholder in the ⌘K palette's field in the normal case. “Search” governs all four objects: tabs, history, actions and the web. Actions are the browser commands the palette can run. Sentence case."
    },
    "Search tabs, history, and actions" : {
      "comment" : "Accessibility label for the command palette's search field. It names the three local result groups the field searches."
    },
    "Search the Web" : {
      "comment" : "Tool name in assistant settings: searching with the search engine."
    },
    "Search URL" : {
      "comment" : "Title of the row where a custom search engine address is typed, and the same wording in the Settings search index. URL is the technical term for a web address — keep it. Sentence case."
    },
    "Search websites" : {
      "comment" : "Placeholder in the field that filters the website-data list by name. Imperative."
    },
    "Search with %@" : {
      "comment" : "Detail line under the top row of the address bar results when what was typed is a query. %@ is the chosen search engine's name (DuckDuckGo, Google…) — never translated."
    },
    "Search with %@ in a new tab" : {
      "comment" : "Detail line under the second row of the ⌘K palette results when what was typed is a query; ⇧Return, or a Command-click, runs the search beside the current page instead of in it. %@ is the chosen search engine's name (DuckDuckGo, Google…) — never translated."
    },
    "Search, “@” to ask, or enter website name" : {
      "comment" : "Placeholder in the address/ask field at the top of the window and on the start page. The “@” is literal: typing it at the start of the line addresses the assistant instead of searching, so the character must stay, stay leading, and stay in quotes. “enter website name” follows Safari’s own placeholder — use the system’s wording for it. Sentence case."
    },
    "Searching the web for “%@”…" : {
      "comment" : "Status line under the assistant’s reply while it runs a web search. %@ is what is being searched for, in the user’s own words, and is not translated. Curly quotation marks and a real ellipsis."
    },
    "Searching the web…" : {
      "comment" : "Status line under the assistant’s reply while it runs a web search with no search words to show. Present participle; real ellipsis."
    },
    "See the addresses and titles of your open tabs" : {
      "comment" : "One bullet in the list of what a browser extension will be able to do, shown in the install confirmation dialog. Addresses means web addresses. It follows the line It will also be able to:, so it is a bare verb phrase and takes no final full stop."
    },
    "See your location" : {
      "comment" : "One bullet in the list of what a browser extension will be able to do, shown in the install confirmation dialog. It follows the line It will also be able to:, so it is a bare verb phrase and takes no final full stop."
    },
    "Select All" : {
      "comment" : "Standard macOS Edit menu command, shortcut ⌘A. Use Apple’s own wording for it in the target language."
    },
    "Send you notifications?" : {
      "comment" : "Question in the permission panel when a website asks to send notifications. The website is named in the header just above, so the question deliberately has no subject. Use “send” rather than “show”."
    },
    "Services" : {
      "comment" : "Standard macOS submenu inside the application menu. Use Apple’s own translation of the system Services menu."
    },
    "Session waiting" : {
      "comment" : "Caption under Private Browsing in the profile switcher when a private session is still running while the browser is in another profile. Two short words; the space is tight."
    },
    "Set as Default" : {
      "comment" : "Button that makes Linen the Mac’s default browser. Default is a noun here, meaning the default browser; the button reads simply Default once that is already the case. Title Case."
    },
    "Set as Default…" : {
      "comment" : "Button beside the Open links from other apps row that asks macOS to make Linen the default browser. The ellipsis is there because a system panel opens to confirm; keep it as the single ellipsis character. Title case, as a button naming a command."
    },
    "Set Up…" : {
      "comment" : "Settings → Assistant. Button that opens the page of the chosen provider so its key or server can be fixed."
    },
    "Settings" : {
      "comment" : "Heading at the top of the Settings window’s sidebar, and the name of the entry that opens Settings from the command palette. Apple’s term for what used to be called Preferences — use Apple’s own translation."
    },
    "Settings…" : {
      "comment" : "Menu bar command in the application menu that opens the Settings window, shortcut ⌘,. Title Case with a real ellipsis. Use Apple’s own wording for the system Settings command."
    },
    "SHA-256: %@" : {

    },
    "Show" : {
      "comment" : "Button at the end of the Acknowledgements row on the About settings page. It opens the list of open source packages. A verb; very tight, because it sits in a small chip."
    },
    "Show %@ on the toolbar" : {
      "comment" : "Tooltip on the Pin button in the extensions overflow popover. %@ is the extension’s own display name, taken from the extension’s manifest — it is not translated. Show is a verb, and toolbar is the row of buttons at the top of the window."
    },
    "Show All" : {
      "comment" : "Serves two places at once: the standard macOS application-menu command that unhides all applications, and a button at the end of the start page’s history list that reveals the full list. Use Apple’s own wording for the system command, since that is the one users recognise. Title Case, Show is a verb."
    },
    "Show All History" : {
      "comment" : "Menu bar command under History, shortcut ⌘Y, which opens the full history list. Title Case and established platform terminology."
    },
    "Show all models" : {

    },
    "Show Assistant Activity" : {
      "comment" : "Menu bar command under View that opens the panel showing what the assistant is doing. The same item reads Hide Assistant Activity when the panel is already open, so the two should stay parallel. Title Case."
    },
    "Show Browser" : {
      "comment" : "Menu bar command under View that reveals the web view. The same item reads Hide Browser when the browser is already showing, so the two should stay parallel. Title Case, Show is a verb."
    },
    "Show Extension" : {
      "comment" : "Command in the right-click menu of an extension’s toolbar button, which puts the button back on the toolbar. The same item reads Hide Extension when it is already there, so the two should stay parallel. Title Case, Show is a verb."
    },
    "Show in Finder" : {
      "comment" : "Tooltip on the small folder button beside a finished download, which reveals the file in the Finder. Finder is Apple’s app name — use Apple’s own name for it, and match Apple’s standard wording for this command."
    },
    "Show Last Tab" : {
      "comment" : "Hidden menu command under Window, shortcut ⌘9, which switches to the last tab in the row. Title Case and established platform terminology."
    },
    "Show lyrics" : {
      "comment" : "Title of the switch on the General settings page that adds the lyrics button to the media player, and its settings-search title. Sentence case, as settings rows are."
    },
    "Show Lyrics" : {
      "comment" : "Tooltip on the lyrics button in the media player while the lyrics are hidden. Pairs with “Hide Lyrics”. Title Case."
    },
    "Show Lyrics Earlier" : {
      "comment" : "Tooltip on the − button at the foot of the lyrics view. It moves every line earlier against the sound. Pairs with “Show Lyrics Later”. Title Case."
    },
    "Show Lyrics Later" : {
      "comment" : "Tooltip on the + button at the foot of the lyrics view. It moves every line later against the sound. Pairs with “Show Lyrics Earlier”. Title Case."
    },
    "Show media player" : {
      "comment" : "Label of the switch on the General settings page that decides whether video and sound move into the player in the sidebar. Sentence case, as settings labels are."
    },
    "Show Next Tab" : {
      "comment" : "Menu bar command under Window, shortcuts ⇧⌘] and ⌃Tab, which switches to the tab after the current one. Title Case and established platform terminology."
    },
    "Show or hide the list of tabs." : {
      "comment" : "Description of the Show sidebar switch, shown only in the Settings search results. The list of tabs is the sidebar down the side of the window. Imperative pair with a final full stop."
    },
    "Show Previous Tab" : {
      "comment" : "Menu bar command under Window, shortcuts ⇧⌘[ and ⌃⇧Tab, which switches to the tab before the current one. Title Case and established platform terminology."
    },
    "Show report button" : {

    },
    "Show Side Panel" : {

    },
    "Show sidebar" : {
      "comment" : "Sentence case title of the Appearance settings row that turns the sidebar on, and the same wording in the Settings search index. Show is a verb. Deliberately sentence case, unlike the Title Case menu command with the same words."
    },
    "Show Sidebar" : {
      "comment" : "Menu bar command under View, shortcut ⌃⌘S, which reveals the tab sidebar. The same item reads Hide Sidebar when the sidebar is already showing, so the two should stay parallel. Title Case, Show is a verb."
    },
    "Show Tab %lld" : {
      "comment" : "Hidden menu commands under Window bound to ⌘1 through ⌘8. %lld is the tab’s position in the row, a number from 1 to 8. Title Case and established platform terminology."
    },
    "Show Video" : {
      "comment" : "Tooltip on the same eye button once the picture is hidden; it brings the picture back. Title Case, narrow dock."
    },
    "Show video in the player" : {
      "comment" : "Title of the only row on the Experiments settings page, and the title of that same row in Settings search. It turns on the picture inside the media player in the sidebar."
    },
    "Show what went wrong" : {
      "comment" : "Tooltip on the warning button beside an extension that reported problems; pressing it opens a panel listing them. Show is a verb."
    },
    "Sidebar" : {
      "comment" : "Title of the Appearance settings section for the tab sidebar. A noun heading beside an icon."
    },
    "Sign In" : {
      "comment" : "Default button of the dialog a website shows when it asks for a username and password; pressing it submits what was typed. Title Case, imperative verb."
    },
    "Sign in to %@" : {
      "comment" : "Title of the dialog a website shows when it asks for a username and password. %@ is the website’s hostname, for example example.com."
    },
    "Sign-ins and cookies" : {
      "comment" : "Something a profile keeps separately from every other profile."
    },
    "Signs you out of most websites." : {
      "comment" : "Caption under the Cookies and site data checkbox in the Clear browsing data section, warning what clearing them will do. The implied subject is the clearing. Third person singular; website is one word."
    },
    "Since %@" : {
      "comment" : "How far back a profile’s history goes, joined to the page count by “ · ”. %@ is a date, such as “March 4”. A fragment, not a sentence."
    },
    "sing along with the track" : {
      "comment" : "Second line of the Show Lyrics row in the command palette, under the command name. A fragment, not a sentence: lower case and no final full stop, as every palette caption is."
    },
    "Size on disk" : {
      "comment" : "Title of the row saying how much room a profile takes up."
    },
    "Skip Setup" : {
      "comment" : "Secondary button on the onboarding screens; ends onboarding without granting anything. Title Case."
    },
    "Sleep inactive tabs" : {
      "comment" : "Title of the switch in Settings > General that lets Linen release the pages of background tabs when the Mac runs short of memory, and the same row in Settings search. Off by default. Sentence case; “Sleep” is a verb the browser does to the tabs."
    },
    "Small" : {
      "comment" : "First of the four sizes in the lyrics text-size menu (Small, Regular, Large, Extra Large). An adjective for the size of the words. Title Case, as macOS menu items are."
    },
    "Software update" : {
      "comment" : "Sentence case name of the same update section as it is indexed for the Settings search. Apple’s term for the same thing on macOS — use Apple’s own translation."
    },
    "Software Update" : {
      "comment" : "Title Case heading of the update section in Settings, above the current status. Apple’s term for the same thing on macOS — use Apple’s own translation."
    },
    "Software updates can fail when Linen runs from another folder. Linen will copy itself to Applications and reopen." : {
      "comment" : "Body of the same alert for a copy that runs from a disk image, which cannot be written to. Only the verb differs from the “move itself” wording: the original stays on the image."
    },
    "Software updates can fail when Linen runs from another folder. Linen will move itself to Applications and reopen." : {
      "comment" : "Body of that alert, for a copy that can be moved — usually one sitting in the Downloads folder. The second sentence promises what the default button does. Use the system name of the Applications folder."
    },
    "Something else…" : {
      "comment" : "Last entry in the search engine pop-up menu, chosen when the user wants an engine that is not listed and will type its address instead. Real ellipsis, promising that a field appears."
    },
    "Space" : {
      "comment" : "Legend printed on a key cap in the shortcut recorder in Settings, where the user records the key that activates the assistant. Use the word your language's Apple keyboards print on that key; the cap is only a few characters wide. This one is the space bar."
    },
    "Speak answers as they arrive." : {
      "comment" : "Settings search caption for Read aloud. The page caption adds a System Settings link."
    },
    "Speak answers as they arrive. Change the voice or speed in [System Settings](x-apple.systempreferences:com.apple.preference.universalaccess?TextToSpeech)." : {

    },
    "Split Down" : {
      "comment" : "Menu command that opens a new tab in a second pane below the current page. Title Case. Down is the direction the new page appears in."
    },
    "Split Right" : {
      "comment" : "Menu command that opens a new tab in a second pane beside the current page, on its right. Title Case. Right is the side the new page appears on; mirror it for a right-to-left language."
    },
    "Split View" : {
      "comment" : "Title of the View menu's submenu for showing two pages at once. Title Case, as menu titles are. It names the feature, so use whatever your language's browsers call a two-pane window."
    },
    "Stack Pages" : {
      "comment" : "Menu command that rearranges two pages shown at once from side by side into one above the other. Title Case. Its opposite is Place Side by Side, and the menu shows whichever one is available."
    },
    "Standard" : {
      "comment" : "Name of the conventional non-Liquid Glass window style in Appearance settings. It follows the selected light or dark theme and can optionally use Website tint."
    },
    "Start it with `ollama serve`, then pull a tool-capable model such as `qwen3.5` or `llama3.1`." : {
      "comment" : "Setup hint shown when Ollama is installed but not reachable. Everything inside backticks is literal and must be kept exactly: ollama serve is a command the user types, and qwen3.5 and llama3.1 are model names. Pull is Ollama’s word for downloading a model; tool-capable means the model can call the browser’s tools."
    },
    "Start Listening" : {
      "comment" : "Command that turns the microphone on so the person can speak to the assistant. The same command reads “Stop Listening” while it is on. Title Case."
    },
    "Start page" : {
      "comment" : "Name of the page Linen shows in a new tab, offered as one choice in the New tab control. A noun phrase naming a specific screen in this app, not an instruction. Short segment, so keep it brief."
    },
    "Start Page" : {
      "comment" : "Heading of the popover that chooses which sections the start page shows. It is the app's name for the page a new tab opens on. Title Case."
    },
    "Stop" : {
      "comment" : "Serves two places: the menu bar command under View that stops the page loading, shortcut ⌘., and the tooltip on the small cross that cancels a download in progress. Imperative verb in both."
    },
    "Stop and Run" : {
      "comment" : "Tooltip on the microphone button while it is listening: one click ends the utterance and sends what was heard to the assistant. Two verbs on one control, Title Case; alternates with “Click to Talk”."
    },
    "Stop Listening" : {
      "comment" : "Command that turns the microphone off. The same command reads “Start Listening” while it is off. Title Case."
    },
    "Stop Loading" : {
      "comment" : "Command that stops the page loading, the ⌘. command. Title Case."
    },
    "Stop Speaking" : {
      "comment" : "Tooltip on the toolbar's speaker button while the assistant is reading a reply aloud; clicking cuts the speech off mid-sentence. It does not change any setting. Title Case."
    },
    "Stopped" : {
      "comment" : "Small chip in the agent activity panel marking a task the user cancelled. One word; very tight."
    },
    "Stopped at %@" : {

    },
    "Stopped at %@ of %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Stopped at %1$@ of %2$@"
          }
        }
      }
    },
    "Stored on this Mac" : {
      "comment" : "Heading of the list of websites holding data locally. Past participle describing the list below, not an instruction."
    },
    "Streaming, tool calling, and reasoning control." : {
      "comment" : "One-line description of the OpenAI provider in the provider picker. All three are technical AI-API capabilities: streaming replies, calling tools, and choosing how much the model reasons. Keep the established terms of the target language’s AI vocabulary."
    },
    "Suggested" : {
      "comment" : "Heading over the group of recommended models at the top of the model pop-up menu. Adjective describing the models below it."
    },
    "Suggestions from %@ appear as you type." : {
      "comment" : "Caption under the Search suggestions row. %@ is the search engine's brand name, for example Google or DuckDuckGo — leave the inserted name as is. The alternative caption, used when the engine offers none, is %@ doesn’t offer suggestions."
    },
    "Suggestions from your search engine as you type." : {
      "comment" : "Description of the Search suggestions row, shown only in the Settings search results, where the chosen engine is not known and is named generically. Sentence case with a final full stop."
    },
    "Swap Pages" : {
      "comment" : "The same command as Swap Panes, on the context menu of a page and of a sidebar row holding two tabs. Title Case. It says pages here because the menu is on the page itself."
    },
    "Swap Panes" : {
      "comment" : "Menu command that makes two pages shown at once change places. Title Case. Panes are the two regions the window is divided into."
    },
    "Swap with this page" : {
      "comment" : "Caption shown over a page while another page of the same window is dragged onto it. The two exchange places; neither leaves the window. Sentence case, no final period."
    },
    "Switch Tabs" : {
      "comment" : "Tool name in assistant settings: switching between tabs."
    },
    "Switch to Tab" : {
      "comment" : "Section heading in the address bar results list over rows for tabs that are already open; choosing one switches to it rather than loading a second copy. Title Case."
    },
    "Switching tabs…" : {
      "comment" : "Status line under the assistant’s reply while it moves to a different tab. Real ellipsis."
    },
    "Symbol" : {
      "comment" : "Label of the grid of symbols that stand for a profile."
    },
    "System" : {
      "comment" : "Name of the System group in the Settings sidebar. Short section heading."
    },
    "System Settings is open. Choose Linen under “Default web browser.”" : {

    },
    "tab" : {
      "comment" : "Detail line on a ⌘K palette row for an open tab, used only when that tab has no host to show. The noun (a browser tab), lowercase as a caption; capitalise if your language capitalises nouns."
    },
    "Tab" : {
      "comment" : "Legend printed on a key cap in the shortcut recorder in Settings, where the user records the key that activates the assistant. Use the word your language's Apple keyboards print on that key; the cap is only a few characters wide. This one is the Tab key on the keyboard — not a browser tab."
    },
    "Tabs" : {
      "comment" : "Heading of the tab commands in the ⌘K command palette: new tab, close tab, reopen, pin. Title Case, plural noun."
    },
    "Tabs and folders" : {
      "comment" : "Something a profile keeps separately from every other profile."
    },
    "Tabs that don’t fit a group stay where they are." : {

    },
    "Take this page’s place" : {
      "comment" : "Caption shown over a page while another is dragged onto it, when the window is already showing as many as it can. The page underneath goes back to being an ordinary sidebar row rather than being closed. Sentence case, no final period; curly apostrophe."
    },
    "Talk to apps outside the browser" : {
      "comment" : "One bullet in the list of what a browser extension will be able to do, shown in the install confirmation dialog. Apps means other applications on the Mac. It follows the line It will also be able to:, so it is a bare verb phrase and takes no final full stop."
    },
    "Teal" : {
      "comment" : "Tooltip and accessibility label for one swatch in the colour row of a sidebar folder's context menu, the way the Finder labels its tag colours. A colour name on its own, Title Case; the swatch is 18 points across, so keep it to one word."
    },
    "Text Size" : {
      "comment" : "Tooltip on the aA button at the top of the lyrics view. Its menu sets how large the words are. Title Case."
    },
    "That username or password wasn’t accepted. Try again." : {
      "comment" : "Message inside the website sign-in dialog after a failed attempt. Curly apostrophe."
    },
    "The active tab changed before the assistant could finish." : {

    },
    "The active tab changed before the assistant could use it." : {

    },
    "The assistant can read it for this question" : {

    },
    "The assistant may do these without asking: %@. Change this in Assistant settings." : {
      "comment" : "Note on a website's page when the assistant holds standing permission there. %@ is a list of action kinds already worded and joined, for example purchases and money transfers. Assistant is the name of a Settings page."
    },
    "The assistant wants to click “%@” %@. This %@ and usually can’t be undone." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The assistant wants to click “%1$@” %2$@. This %3$@ and usually can’t be undone."
          }
        }
      }
    },
    "The assistant will ask again before acting on these websites." : {
      "comment" : "Message inside the dialog confirming that every saved assistant permission will be withdrawn. Plural, because it covers all the listed websites at once."
    },
    "The assistant will ask again before acting on this website." : {
      "comment" : "Message inside the dialog confirming that the assistant permissions saved for one website will be withdrawn. Singular counterpart of the plural sentence used for the withdraw-everything dialog."
    },
    "the bookmarked page" : {
      "comment" : "Last-resort name for a tab's bookmarked page when it has neither title nor host, dropped into “Back to %@”. Deliberately lowercase and with an article because it lands mid-sentence; capitalise only if your language demands it."
    },
    "The bookmarks go into a new folder in the sidebar." : {
      "comment" : "Second sentence of the confirmation dialog shown before bookmarks are imported. It says where they land."
    },
    "The browser action failed…" : {
      "comment" : "Status line under the assistant’s reply when one of its actions on the page did not work. Real ellipsis."
    },
    "The Chrome Web Store returned HTTP %lld" : {
      "comment" : "Error shown when downloading an extension fails. %lld is the HTTP status code the store’s server replied with, for example 404. Chrome Web Store is Google’s product name — leave as is, and HTTP is a protocol name."
    },
    "The connection dropped" : {
      "comment" : "Headline on the error page shown when the network connection was lost part way through loading. A short sentence in sentence case, displayed large above a longer explanation."
    },
    "The default for every website. Individual tabs can still be zoomed." : {
      "comment" : "Caption under the Page zoom row, saying the chosen percentage applies everywhere but does not stop a single tab being zoomed on its own. Two sentences; website is one word."
    },
    "The downloaded file is not a supported extension package" : {
      "comment" : "Error shown when an extension install fails because the downloaded file is not in the expected format. No final full stop."
    },
    "The extension package failed signature verification" : {
      "comment" : "Error shown when an extension install fails because its cryptographic signature did not check out. No final full stop."
    },
    "The extension package header is malformed" : {
      "comment" : "Error shown when an extension install fails because the file’s header could not be read. Header is the technical term for the leading block of the file. No final full stop."
    },
    "The extension will also be able to:" : {
      "comment" : "Line introducing the bulleted list of abilities in the extension install sheet; each bullet below it is a separate entry that must read as a continuation of this line. Keep the colon."
    },
    "The folder is empty." : {
      "comment" : "Detail line of the delete-folder alert when the folder holds no tabs."
    },
    "The issue has cleared — turn the extension off and on to refresh the badge." : {
      "comment" : "Text in the panel that lists an extension’s problems, shown when there are no problems left to list. Badge means the small warning marker still shown beside the extension. Em dash."
    },
    "The key is deleted from your Keychain, and %@ stops answering until you add another." : {
      "comment" : "Explanatory text in the confirmation sheet for removing a stored API key. %@ is the provider’s name, e.g. OpenAI. “Keychain” is the macOS password store — use Apple’s own name for it."
    },
    "The Keychain refused to store the key (error %d)." : {
      "comment" : "Error shown when the API key could not be saved. %d is the numeric error code macOS reported. Key means API key; Keychain is Apple’s password store — use Apple’s own name for it."
    },
    "the last 4 weeks" : {
      "comment" : "Lowercase phrase naming a time range, inserted mid-sentence into the confirmation before clearing browsing data, which reads roughly: browsing history will be cleared for the last 4 weeks. Deliberately lowercase, including the leading article — do not capitalise it. The capitalised menu label Last 4 weeks is a separate string."
    },
    "the last 7 days" : {
      "comment" : "Lowercase phrase naming a time range, inserted mid-sentence into the confirmation before clearing browsing data, which reads roughly: browsing history will be cleared for the last 7 days. Deliberately lowercase, including the leading article — do not capitalise it. The capitalised menu label Last 7 days is a separate string."
    },
    "the last 24 hours" : {
      "comment" : "Lowercase phrase naming a time range, inserted mid-sentence into the confirmation before clearing browsing data, which reads roughly: browsing history will be cleared for the last 24 hours. Deliberately lowercase, including the leading article — do not capitalise it. The capitalised menu label Last 24 hours is a separate string."
    },
    "the last hour" : {
      "comment" : "Lowercase phrase naming a time range, inserted mid-sentence into the confirmation before clearing browsing data, which reads roughly: browsing history will be cleared for the last hour. Deliberately lowercase, including the leading article — do not capitalise it. The capitalised menu label Last hour is a separate string."
    },
    "The last profile used" : {
      "comment" : "One of two choices for which profile the browser opens in."
    },
    "The list is based on tracker URLs referenced by this page." : {

    },
    "The model couldn’t group the tabs. Try again." : {
      "comment" : "Message shown when the Organize Tabs command asked the language model to sort the open tabs into folders and the reply could not be used. The model is the AI; try again is addressed to the person. Curly apostrophe."
    },
    "The model returned an empty response. Try again or choose another model." : {
      "comment" : "Error shown when the language model answers with nothing at all. Model means the AI model."
    },
    "The model the assistant answers with." : {
      "comment" : "Settings search description for the Model row on the Assistant page. The row itself carries no caption."
    },
    "The network went away mid-transfer. Try again." : {
      "comment" : "Explanation on the error page shown when the connection was lost part way through loading, below the headline."
    },
    "The open source packages Linen is built with." : {

    },
    "The package isn’t signed by this extension’s own key" : {
      "comment" : "Error shown when an extension install fails because the file’s signature belongs to a different extension. Key means cryptographic signing key. Curly apostrophes, no final full stop."
    },
    "the page" : {
      "comment" : "Lowercase fragment inserted where a website’s hostname would go in the assistant’s status line, used when the address has no hostname: Opening the page… Deliberately lowercase because it sits inside that line rather than starting it."
    },
    "The page changed before the assistant could use it." : {

    },
    "The page couldn’t be saved." : {
      "comment" : "Message of the warning shown when the web archive file could not be written. The reason supplied by macOS follows below it. Curly apostrophe."
    },
    "The page moved to another website. Use Read Page before the assistant reads or controls it." : {
      "comment" : "Message shown in the agent activity panel when the page navigated away before the assistant could act. Read Page is the name of one of the assistant’s tools — keep its capitalisation."
    },
    "the research page" : {
      "comment" : "Last-resort stand-in for a host name, dropped into “Browsing %@…” and “Finished on %@” in the agent activity column when the page the assistant is on has no host to show. Deliberately lowercase with an article because it lands mid-sentence."
    },
    "The selected tab uses the website icon’s color." : {
      "comment" : "Caption under the “Tint selected tab” switch on the Appearance settings page, and the same wording in Settings search. One full sentence."
    },
    "The server accepted the connection but never replied." : {
      "comment" : "Explanation on the error page shown when a website timed out, below the headline."
    },
    "The server asked for a username and password." : {
      "comment" : "Explanation on the error page shown when a website requires authentication, below the headline."
    },
    "The server refused the connection or isn’t running." : {
      "comment" : "Explanation on the error page shown when the site could not be reached, below the headline. Curly apostrophe."
    },
    "The sidebar shows what’s playing, so you can pause or skip from any tab." : {
      "comment" : "Caption under the “Show media player” switch on the General settings page, and the same sentence in settings search. The player is a strip in the sidebar naming the track and carrying the transport buttons; it does not move the sound or the picture out of the tab. One full sentence."
    },
    "The speech engine is still warming up." : {
      "comment" : "Brief status line shown when the user tries to speak before the speech recogniser has finished starting up. Conversational and reassuring."
    },
    "The start page, your homepage, or nothing." : {
      "comment" : "Description of the New tabs open with row, shown only in the Settings search results. Start page is the app's own new-tab page and homepage is the address the person chose; nothing means an empty tab. Sentence case with a final full stop."
    },
    "The text in this form was written by AI, not by you. Publishing it puts AI-generated text out under your name." : {

    },
    "The website asks again before using the camera, microphone, location, or notifications, and the assistant asks before reading it." : {
      "comment" : "Message in the reset confirmation, saying what the website goes back to. Third person singular."
    },
    "The website stays in memory even when unused." : {
      "comment" : "Caption under the Keep loaded switch. Normally an unused tab is unloaded to free memory and reloads when you return to it."
    },
    "The website’s certificate couldn’t be verified, so Linen stopped before sending anything." : {
      "comment" : "Explanatory sentence on the certificate error page, under its headline. Curly apostrophes."
    },
    "The websites you visit most, your recent requests, and your downloads." : {
      "comment" : "Caption for the new-tab choice that opens the start page, naming what the start page shows."
    },
    "Theme" : {
      "comment" : "Title of the Appearance settings row that chooses light, dark or automatic, and the same word in the Settings search index. Noun; a short row title."
    },
    "Thinking" : {
      "comment" : "Title of the Provider settings row that sets how much reasoning effort the model spends, and the same word in the Settings search index. A noun naming the model’s reasoning, not a progress message."
    },
    "Thinking…" : {
      "comment" : "Status line under the assistant’s reply while it waits for the model, before any action has started. Real ellipsis; unlike the row title with the same word, this one is a progress message."
    },
    "Thinks as long as it needs, so replies start after a pause." : {
      "comment" : "Caption under the Thinking segmented control in Settings > Provider, describing the High level of reasoning effort."
    },
    "Thinks through multi-step tasks, and is noticeably slower." : {
      "comment" : "Caption for the Medium level of the reasoning-effort control. The implied subject is the model."
    },
    "This connection isn’t private" : {
      "comment" : "Headline on the error page shown when a website’s security certificate could not be verified. A short sentence in sentence case, displayed large above a longer explanation. Curly apostrophe."
    },
    "This extension asks for no special access." : {
      "comment" : "Body of the extension install confirmation dialog when the extension requests no permissions and no website access at all, shown in place of the bulleted lists."
    },
    "This extension isn’t supported by WebKit" : {
      "comment" : "Error shown when an extension cannot be installed because the browser engine will not load it. WebKit is Apple’s browser engine — leave as is. Curly apostrophe, no final full stop."
    },
    "This extension’s package couldn’t be unpacked" : {
      "comment" : "Error shown when an extension install fails because its downloaded archive could not be opened. Package means the downloaded file. Curly apostrophes, no final full stop."
    },
    "This extension’s package has no manifest" : {
      "comment" : "Error shown when an extension install fails because the package holds no manifest.json. Manifest is the extension’s own description file — keep the term. Curly apostrophe, no final full stop."
    },
    "This file couldn’t be read." : {
      "comment" : "Caption under the Bookmarks row when the chosen file could not be opened, or was not a bookmarks file."
    },
    "This isn’t a valid URL. Try http://localhost:8000/v1" : {
      "comment" : "Error under the field where a user-added endpoint address is typed. The address is an example of the expected form and must be kept exactly as it is. URL is the technical term for a web address; curly apostrophe."
    },
    "This Mac isn’t connected to the internet." : {
      "comment" : "Explanation on the error page shown when the Mac is offline, below the headline. Curly apostrophe."
    },
    "This page" : {
      "comment" : "Stand-in for the website's name in the header of the permission panel when there is no host to show. Noun phrase, tight — it sits on one line beside the favicon."
    },
    "This page didn’t load" : {
      "comment" : "Headline on the error page used for any failure the app has no specific wording for. A short sentence in sentence case, displayed large above the system’s own error text. Curly apostrophe."
    },
    "This provider has no endpoint set." : {
      "comment" : "Message shown for a user-added provider whose server address is missing, both as a reason it is unavailable and as an error when its model list is fetched. Provider means the AI provider; endpoint is the technical term for the server address."
    },
    "This task needed more steps than expected. Try asking again." : {
      "comment" : "What the assistant says when it gives up after too many attempts. Neutral and impersonal — the assistant does not speak about itself in the first person."
    },
    "This website is asking for a username and password for “%@”." : {
      "comment" : "Message inside the dialog a website shows when it asks for HTTP authentication. %@ is the realm name the server itself supplied, which is not translated and may be cut off after 80 characters with an ellipsis. Curly quotation marks."
    },
    "This website is asking for a username and password." : {
      "comment" : "Message inside the dialog a website shows when it asks for HTTP authentication, used when the server supplied no realm name."
    },
    "This website is Read Only for the assistant. Change Assistant Access in Site Settings to allow control." : {
      "comment" : "Message shown when the assistant tries to control a page it may only read. Read Only, Assistant Access and Site Settings are feature names — keep their capitalisation."
    },
    "This website needs a sign-in" : {
      "comment" : "Headline on the error page shown when a website requires authentication. A short sentence in sentence case, displayed large above a longer explanation."
    },
    "This website took too long" : {
      "comment" : "Headline on the error page shown when a website timed out. A short sentence in sentence case, displayed large above a longer explanation."
    },
    "This website’s identity can’t be verified" : {

    },
    "Tint selected tab" : {
      "comment" : "Title of the Appearance settings switch that colors the selected sidebar tab using the website icon, and the same row in Settings search. Sentence case; tint is a verb."
    },
    "to skip" : {

    },
    "to speak" : {
      "comment" : "Second half of the hint under the empty address field: “hold ⌥Space to speak”, with the recorded shortcut drawn as key caps between “hold” and this string. A purpose clause, deliberately lowercase and very short; it must read as one phrase with the “hold” entry."
    },
    "Today" : {
      "comment" : "Heading over the group of history entries from today. Sits in a list where the next heading is “Yesterday” and older ones are weekday and date names written by the system, so it should match those in tone."
    },
    "Tools" : {
      "comment" : "Title of the Tools settings page, and its row on the Assistant page."
    },
    "Tracker blocking" : {
      "comment" : "Something a profile keeps separately from every other profile."
    },
    "trackers allowed" : {
      "comment" : "Fragment in the one-line summary under a website, meaning tracker blocking is switched off there. Lower case: joined with other fragments."
    },
    "Try Again" : {
      "comment" : "Button that retries a failed agent turn or a failed update check."
    },
    "Turn on Apple Intelligence in System Settings." : {
      "comment" : "Setup hint shown when the Apple Intelligence provider is chosen but not enabled on the Mac. Apple Intelligence and System Settings are Apple’s names — use Apple’s own translations, since the user has to find them on screen."
    },
    "Turn scripts off for every website." : {
      "comment" : "Settings search caption for the JavaScript switch, which carries no caption on the page."
    },
    "Turn sections on or off. Drag to reorder." : {
      "comment" : "Caption under the Start Page heading in the editor popover. Two short sentences."
    },
    "Turn them on in Settings › General." : {
      "comment" : "Caption under “Lyrics are off”. “Them” is the lyrics. The › is the separator macOS uses between a settings window and one of its pages; keep the page names as they are translated elsewhere. Full sentence."
    },
    "Turn this off if the website breaks." : {
      "comment" : "Caption under the Block known trackers switch on one website's page, saying what to do when tracker blocking stops a website working. Imperative."
    },
    "Type" : {
      "comment" : "Tool name in assistant settings: typing into fields on a web page."
    },
    "Type @ in the address bar to start one on this page." : {
      "comment" : "Caption under “No tasks yet”. “One” is a task. The @ is the character that addresses the assistant and is never translated. Full sentence."
    },
    "Type > for commands" : {
      "comment" : "Note beside the Actions heading in the ⌘K palette, telling the reader that typing the greater-than sign filters the list down to commands only. Keep the “>” character as it is: it is the key the user presses, not punctuation."
    },
    "Type the ID exactly as the provider spells it." : {
      "comment" : "Caption above the field where a model identifier is typed by hand. ID means the model’s identifier string; provider means the AI provider. Type is a verb."
    },
    "Type your question" : {
      "comment" : "Stands in for the question in the Ask row of the address bar results, from the moment “@” is typed until a question is actually there. The row leads the list so that Return sends a question rather than attaching a tab. Sentence case, imperative."
    },
    "Typing “%@”…" : {
      "comment" : "Status line under the assistant’s reply while it types into a field on the web page. %@ is the text being typed and is not translated. Curly quotation marks and a real ellipsis."
    },
    "Typing…" : {
      "comment" : "Status line under the assistant’s reply while it types into a field on the page and the text is unknown. Present participle; real ellipsis."
    },
    "Unavailable" : {
      "comment" : "Status shown beside a chosen AI provider that cannot run on this Mac. A single word in a narrow status chip, so keep it short."
    },
    "Understanding the request" : {
      "comment" : "Title of the first step in the assistant’s activity trace, shown while it works out what was asked. A noun phrase describing the step, not a sentence."
    },
    "Undo" : {
      "comment" : "Standard macOS Edit menu command, shortcut ⌘Z. Use Apple’s own wording for it in the target language."
    },
    "Unexpected response from the provider" : {
      "comment" : "Error shown when the AI provider’s reply could not be understood. Provider means the AI provider. No final full stop."
    },
    "Unfinished work you can try. Anything here can change or go away." : {
      "comment" : "Caption under the Experiments heading. It warns that everything on the page is unfinished and may be removed."
    },
    "unknown" : {
      "comment" : "Lowercase word used as the provider’s error message when the server’s reply carried none; it is then inserted after the colon in a line such as Provider error 500: unknown. Deliberately lowercase because it sits mid-sentence."
    },
    "Unloaded to save memory. It reloads when selected." : {
      "comment" : "Tooltip on a background tab after its web process was released. Two short sentences."
    },
    "Unmute" : {
      "comment" : "Tooltip on the same speaker button in the media dock once sound is off; it lets the sound back. Verb, one word; pairs with “Mute”."
    },
    "Unmute Tab" : {
      "comment" : "Tooltip on the same small speaker button in a sidebar tab row once the tab has been silenced; it lets the sound back. Title Case, narrow row."
    },
    "Unmute This Tab" : {
      "comment" : "Tooltip on the toolbar's speaker button once the current tab has been silenced. Title Case."
    },
    "Unsupported CRX container version %lld" : {
      "comment" : "Error shown when an extension package uses a file format version the app cannot read. %lld is the version number found in the file. CRX is the name of Chrome’s extension package format — leave as is. No final full stop."
    },
    "Untitled" : {
      "comment" : "Name suggested in the save panel for a page that has no title and no address to name the file after. A noun."
    },
    "Up to date" : {
      "comment" : "Update status meaning no newer version exists, shown both in the Settings update section and on the sidebar update card. An adjective phrase describing the app."
    },
    "Update Available" : {
      "comment" : "Compact title in the blue-tinted sidebar banner when a newer version of Linen can be installed. Title Case."
    },
    "Update channel" : {
      "comment" : "Title of the pop-up menu in Settings > About that chooses which builds the app updates to. The choices are “Release” and “Preview”. Sentence case. “Channel” is the usual software word for a stream of builds."
    },
    "update.banner.downloadingShare" : {
      "comment" : "Title of the software-update button in the sidebar while a release is being fetched. %@ is an already-formatted percentage and carries its own per-cent sign. Kept separate from “Downloading %@”, where %@ is a version number instead. The button is narrow, so keep this short.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Downloading %@"
          }
        }
      }
    },
    "update.banner.install" : {
      "comment" : "The one button that updates the app, in the update banner and on the About settings page. One click downloads the update, installs it and restarts Linen; there is no second step. A verb (a command). Its twin is the plain “Install” key, the extension button — the same English word for a different button, so the two are kept apart. The button is narrow, so keep this short.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Install"
          }
        }
      }
    },
    "update.banner.preparingShare" : {
      "comment" : "Title of the software-update button in the sidebar while the downloaded release is being unpacked. %@ is an already-formatted percentage and carries its own per-cent sign. Kept separate from “Preparing %@”, where %@ is a version number instead. The button is narrow, so keep this short.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Preparing %@"
          }
        }
      }
    },
    "Use %@" : {
      "comment" : "Settings → Assistant → a provider page. %@ is the provider name, e.g. \"Ollama\". Button that makes this provider the one that answers."
    },
    "Use %@ where the search term goes." : {
      "comment" : "Caption under the Search URL field, telling the user what to put in their custom search address. %@ is always filled with the literal two characters %s, which the user has to type into the address — it is inserted rather than written in the text so it is not mistaken for a format specifier. Keep it as a placeholder; do not translate what it stands for."
    },
    "Use %s where the search term goes." : {
      "comment" : "The same instruction as it is indexed for the Settings search, where the token is written out literally. %s here is not a placeholder to be filled in — it is the exact text the user has to type into their custom search address, so keep the two characters %s unchanged."
    },
    "Use https — plain http would send your API key in the clear. Only localhost can use http." : {
      "comment" : "Error under the field where a user-added endpoint address is typed, shown when a remote address uses an insecure protocol. https, http and localhost are technical terms and must stay exactly as they are, including their lowercase spelling. In the clear means unencrypted."
    },
    "Use Icons Only" : {
      "comment" : "Checkmark item in the right-click menu of the sidebar toggle button; switches the sidebar to its narrow favicons-without-titles look. The same choice Settings calls “Icons only”. Title Case."
    },
    "Use Recommended" : {
      "comment" : "Button in the warning row on the Tools settings page."
    },
    "Use the current website’s color in the toolbar and sidebar." : {
      "comment" : "Caption for the Website tint toggle in Appearance settings and the same wording in Settings search. Curly apostrophe."
    },
    "Use This Page" : {
      "comment" : "Button that sets the homepage to the page currently open. Title Case, imperative verb; This Page means the page in the front tab."
    },
    "Use your camera?" : {
      "comment" : "Question in the permission panel when a website asks for the camera. The website is named in the header just above, so the question deliberately has no subject."
    },
    "Use your current location?" : {
      "comment" : "Question in the permission panel when a website asks for location. The website is named in the panel's header just above, so the question has no subject of its own. Keep it a bare question and retain “current location”."
    },
    "Use your microphone?" : {
      "comment" : "Question in the permission panel when a website asks for the microphone. The website is named in the header just above, so the question deliberately has no subject."
    },
    "Used when you or the assistant search the web." : {
      "comment" : "Settings search caption for Search engine. The page caption names the chosen model instead."
    },
    "User agent" : {
      "comment" : "Title of the System settings row that chooses what the browser reports itself as to websites, and the same wording in the Settings search index. User agent is the established technical term — use the term browsers use in the target language. Sentence case."
    },
    "Username" : {
      "comment" : "Placeholder text inside the username field of the dialog a website shows when it asks for HTTP authentication."
    },
    "Using `%@` from the environment." : {
      "comment" : "Caption under the API key row when the key is being taken from an environment variable rather than the Keychain. %@ is the variable’s name, for example OPENAI_API_KEY — leave it exactly as it is. The backticks mark it as code and must be kept."
    },
    "Usually a part of the extension WebKit doesn’t support. The rest keeps working." : {
      "comment" : "Explanatory line at the foot of the panel listing an extension’s problems. A sentence fragment whose implied subject is the problem; the rest means the rest of the extension. WebKit is Apple’s browser engine — leave as is. Curly apostrophe."
    },
    "Version %@" : {
      "comment" : "Line beside the Linen heading on the About page in Settings. %@ is the version number of the running app, for example 1.4.2."
    },
    "Version %@ is available. Installing restarts Linen." : {
      "comment" : "Status line under the Software Update heading in Settings when a newer release exists. %@ is the new version number, e.g. 1.4.2. The second sentence is the only warning the user gets: the Install button does not ask again."
    },
    "Video and audio may start playing as soon as a page loads." : {
      "comment" : "Caption for the most permissive choice of the Autoplay setting, describing what that choice allows websites to do."
    },
    "Video moves into a floating window when you leave its tab or switch to another app." : {
      "comment" : "Caption under the Automatic Picture in Picture row on the General settings page, and the caption of that same row in Settings search. It names the two moments the video floats. One full sentence."
    },
    "Video plays without sound until you click." : {
      "comment" : "Caption for the middle choice of the Autoplay setting: pictures may start on their own but sound may not."
    },
    "View" : {
      "comment" : "Title of one of the menus in the menu bar. Use Apple’s own wording for the standard View menu in the target language."
    },
    "View on GitHub" : {
      "comment" : "Button in the release notes sheet that opens the release page in a browser. View is a verb; GitHub is a product name — leave as is."
    },
    "Voice" : {
      "comment" : "Heading of the Voice section on the Assistant page in Settings. Noun, meaning speaking to the app and hearing it reply. Sits above two rows, so keep it short."
    },
    "Watch every network request the browser makes" : {
      "comment" : "One bullet in the list of what a browser extension will be able to do, shown in the install confirmation dialog. Watch means observe. It follows the line It will also be able to:, so it is a bare verb phrase and takes no final full stop."
    },
    "Web Inspector" : {
      "comment" : "Title of the System settings row that turns on web developer tools, and the same wording in the Settings search index. Web Inspector is established platform terminology."
    },
    "Webpages can carry hidden instructions aimed at the assistant. Allow this only if it’s what you asked for." : {

    },
    "Website Controls" : {

    },
    "Website data" : {
      "comment" : "Title of the Privacy settings row reporting how many websites are storing something on this Mac, and the same wording in the Settings search index. A noun phrase; sentence case."
    },
    "Website permissions" : {
      "comment" : "Something a profile keeps separately from every other profile; also the title of the row counting them on a profile’s page."
    },
    "Website Settings" : {
      "comment" : "Tooltip on the sliders button at the trailing edge of the address field. Opens settings for the current website. Title Case."
    },
    "Website tint" : {
      "comment" : "Title of a toggle in Appearance settings that colors the browser toolbar and sidebar using the current website. Sentence case."
    },
    "Websites" : {
      "comment" : "Title of the Websites page in Settings and its name in the Settings sidebar. Plural noun; a narrow sidebar row, so keep it short."
    },
    "Websites appear here after you answer their requests." : {
      "comment" : "Guidance under No websites yet, explaining that the list fills itself as websites ask for the permission. Third person plural."
    },
    "Websites appear here after you choose “Always Allow”." : {
      "comment" : "Caption on the empty state of the assistant-permissions list, shown when no website has been granted anything. Always Allow is the exact label of a button in the assistant’s confirmation dialog, so translate it the same way there. Curly quotation marks."
    },
    "Websites the assistant may act on without asking." : {
      "comment" : "Settings search caption for the Assistant permissions section."
    },
    "Websites use this data to keep you signed in and remember your preferences." : {
      "comment" : "Caption under the Website data page title, saying what the stored data is for before offering to remove it. Third person plural."
    },
    "Websites with data" : {
      "comment" : "Label under a number, counting the websites storing something in this profile."
    },
    "Websites you visit most" : {
      "comment" : "Description of the Frequently Visited section in the start page editor. No final full stop."
    },
    "Websites you’ve answered" : {
      "comment" : "Heading of the list of websites that have already been allowed or denied one permission — camera, microphone, location or notifications. Answered refers to answering the website's request. Curly apostrophe."
    },
    "Websites you’ve changed" : {
      "comment" : "Heading of the list of individual websites that carry a rule of their own. Each row opens that website's page. Curly apostrophe."
    },
    "Welcome to Linen" : {
      "comment" : "Heading of the first onboarding screen, shown under the app icon. Linen is the application name and is never translated. Keep it short — it is set in large type."
    },
    "What %@ may do in the browser. Every tool takes a share of the model’s context." : {
      "comment" : "Caption under the Tools page title. %@ is the provider name."
    },
    "what the assistant is doing" : {
