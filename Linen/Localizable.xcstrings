    "Offer to save contact details entered in forms." : {

    },
    "Offer to save new cards at checkout." : {

    },
    "Offer to save new logins after you sign in." : {

    },
    "OK" : {
      "comment" : "Button that simply dismisses an alert, used both for a web page’s own JavaScript alert and for the warning that no app on the Mac handles a link type. It confirms nothing beyond having read the message."
    },
    "on %@" : {
      "comment" : "Fragment inserted into the dialog asking the user to approve an action the assistant wants to take, giving the place: The assistant wants to click “Pay now” on example.com. %@ is the website’s hostname. The alternative fragment, used when there is no hostname, is on this page."
    },
    "On Device" : {
      "comment" : "Chip above the Apple Intelligence card on the model-choice onboarding screen, saying where that model runs. It pairs with “API key required” on the card beside it: both state a plain fact about the choice rather than recommending it. Title Case, and only a few characters wide."
    },
    "On launch" : {

