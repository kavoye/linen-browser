    "Automatic Picture in Picture" : {
      "comment" : "Title of the row that makes video float in its own window on its own: on the General settings page, in Settings search, on a single website’s page under Websites, and in the Site Settings menu in the toolbar. “Picture in Picture” is the macOS name of that window — use the system’s own wording. Title Case."
    },
    "Automatic Picture in Picture is off while \"Show video in the player\" is on in Experiments." : {

    },
    "Automatic Picture in Picture is off, so video stays in its tab everywhere." : {
      "comment" : "Caption on the per-website Automatic Picture in Picture row, shown when the setting is off for every website. “Automatic Picture in Picture” is a link to that row on the General page — spell it exactly as that title."
    },
    "Autoplay" : {
      "comment" : "Title of the row on the Websites settings page controlling whether video and sound may start on their own, and the title of that same row in Settings search. A noun; the browser term."
    },
    "Available to this key" : {
      "comment" : "Heading of the section of the model pop-up menu listing models the stored API key can reach; the parallel heading for local providers is “Pulled locally”. “Key” means the API key."
    },
    "Back" : {
      "comment" : "The command that goes back one page in a tab: an item in the History menu, and the tooltip on the back button at the top of the History page. A direction, not the verb “to back”."
    },
    "Back 15 seconds" : {
      "comment" : "Tooltip on the skip-back button in the media player docked at the foot of the sidebar. The player jumps back exactly fifteen seconds; keep the number. “Back” is directional, not the browser's Back command."
    },
    "Back to %@" : {
      "comment" : "Tooltip on the return arrow of a bookmarked tab that has wandered off its anchor — on the sidebar row and on the toolbar's bookmark button. %@ is the bookmarked page's own title or host, or the fallback phrase “the bookmarked page”, so it drops in mid-sentence. “Back” is directional, not the browser's Back command."
    },
    "Back to Pinned Page" : {
      "comment" : "Command that returns a tab to the page pinned in it: a File menu item, a search palette command, and a tab context-menu item. Title Case, as menu commands are."
    },
    "background scripts" : {
      "comment" : "The same kind of data named partway through a sentence, joined with others into a summary under a website's name. Lower case; never shown alone."
    },
    "Background scripts" : {
      "comment" : "One kind of data a website stores: service workers, which are scripts a website leaves behind to run when it is not open. Named for what it does rather than by its technical name."
    },
    "balanced · default" : {
      "comment" : "Short note beside one suggested model in the model pop-up menu, marking it as the balanced choice and the one used unless another is picked. The middle dot separates the two words and should be kept. Lowercase, and the space is very tight."
    },
    "Base URL" : {
      "comment" : "Title of the field on the custom endpoint page where the model server's address is typed. Technical term — the address a client sends requests to."
    },
    "Best for longer, complex tasks. Your key stays in your Keychain." : {
