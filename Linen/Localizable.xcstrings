    },
    "Additional response parameters" : {

    },
    "Address" : {
      "comment" : "Placeholder in the text field of the sheet that edits a pinned page: the web address the tab returns to. One word, Title Case."
    },
    "Address and search" : {
      "comment" : "Accessibility label for the combined address and search field in the browser toolbar. Keep it short and name both functions."
    },
    "Address bar" : {
      "comment" : "Heading of the Search settings group holding the switch that redirects typed questions to the assistant. Names the field at the top of the browser window. A noun."
    },
    "Address from Contacts" : {

    },
    "Advanced" : {
      "comment" : "Name of the Advanced page in the Settings sidebar and the heading at the top of that page."
    },
    "After one day" : {

    },
    "agent speech" : {
      "comment" : "Detail line under the Enable/Disable Voice command in the ⌘K palette; it names what the command affects — the assistant reading its replies aloud. Lowercase caption fragment; capitalise if your language capitalises nouns."
    },
    "AI replies can be wrong. Check important info." : {
      "comment" : "AI disclosure pinned at the foot of the agent activity column. Must stay short enough to fit one line at the column’s minimum width."
    },
    "AI reply: %@" : {

    },
    "AI summary, can be wrong" : {

    },
    "all time" : {
      "comment" : "Lowercase phrase naming the widest time range, inserted mid-sentence into the confirmation before clearing browsing data, which reads roughly: browsing history will be cleared for all time. Deliberately lowercase — do not capitalise it, even in languages that capitalise nouns. The capitalised menu label All time is a separate string."
    },
    "All time" : {
      "comment" : "Option in the Time range pop-up menu on the Privacy settings page, meaning there is no limit on how far back data is cleared."
    },
    "All websites use the defaults" : {
      "comment" : "Shown under “Website permissions” when a profile has changed none."
    },
    "Allow" : {
      "comment" : "Used twice, as a permission-granting word: the confirming button in the alert asking whether a web page may open another app, and the Autoplay setting meaning video and sound may start on their own. On the button it is a verb."
    },
    "Allow “%@” on %@?" : {
      "comment" : "Heading of the alert asking whether the assistant may click a control that would buy, transfer, delete or post something. The first %@ is the control's label taken from the web page (in the page's own language, inside curly quotes); the second is the website's hostname, e.g. example.com."
    },
    "Allow “%@”?" : {
      "comment" : "Heading of the alert asking whether the assistant may click a control that would buy, transfer, delete or post something, used when no website can be named. %@ is the control's label taken from the web page, in the page's own language and inside curly quotes."
    },
    "Allow %@ to Access These Tabs?" : {

    },
    "Allow %@ to Access This Tab?" : {

    },
    "Allow a hosted shell to run commands and create files." : {

    },
    "Allow a hosted shell to run commands and create files. Extra charges may apply." : {

    },
    "Allow Assistant on %@?" : {

    },
    "Allow Control" : {

    },
    "Allow Control lets the assistant read and use page controls on %@. Read Only blocks this action. Password and payment fields stay blocked." : {

    },
    "Allow Linen to use the microphone under Privacy & Security > Microphone." : {
      "comment" : "Status message shown when the user holds the push-to-talk shortcut but has refused the microphone. “Privacy & Security” and “Microphone” are macOS names — use the system's own wording; the > separates the settings path. Linen is the application name and is never translated."
    },
    "Allow on %@ for This Connection" : {
      "comment" : "Native MCP connection settings or access prompt. MCP is the protocol name. Inserted client names, website addresses, and page titles are supplied at runtime; do not translate them."
    },
    "Allow Once" : {
      "comment" : "Button granting a permission for this visit only: on the permission badge in the toolbar and in the alert asking whether the assistant may click something. It means allow this one time, not permanently. Title Case."
    },
    "Allowed tools" : {

    },
    "Allowed until you leave" : {
      "comment" : "Caption under a permission's name in the site permission panel: the grant lasts only until the user navigates away from the website. Sentence case, one line, tight."
    },
    "Allowed without asking" : {
      "comment" : "Heading of the list of websites the assistant may act on without confirming first. Past participle describing the websites below, not an instruction."
    },
    "Already installed in Linen" : {

    },
    "Also clears your start page tiles and your conversations with the assistant." : {
      "comment" : "Caption under the Browsing history checkbox in the Clear browsing data section, naming the two other things that go with the history. Start page tiles are the frequently visited websites shown on a new tab; the assistant is the AI feature."
    },
    "Also clears your start page tiles." : {
      "comment" : "Message in the Clear history dialog, which clears history only. Start page tiles are the frequently visited websites shown on a new tab, and they go because they are built from history. Third person singular."
    },
    "Always Allow" : {
      "comment" : "Grants a permission permanently: a button on the permission badge in the toolbar, and the saved policy shown in the pop-up menus for camera, microphone, location and notifications on the Websites settings page. Title Case."
    },
    "Always Allow on %@" : {
      "comment" : "Button in the alert asking whether the assistant may click a sensitive control; it grants that category for one website only. %@ is the website's hostname, e.g. example.com. Title Case."
    },
    "Always ask the assistant" : {
      "comment" : "Title of the Settings switch that sends anything you type in the address bar to the assistant instead of the search engine. \"Always\" is about typed questions only — a link or a web address still opens as usual, which the caption underneath says. The feature is called the assistant throughout, never \"AI\". Sentence case, no final full stop."
    },
    "An HTML file from another browser." : {
      "comment" : "Caption under the Bookmarks row on the last onboarding screen. It names the file the user picks. It must stay on one line, so it is shorter than its twin on the General settings page."
    },
    "and %lld more" : {
      "comment" : "Last bullet after a list of website names in the extension install confirmation dialog, when more than eight sites are covered. %lld is how many further websites are not listed. It sits after a bullet character supplied by the app, so it starts mid-line and takes no full stop.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "and %lld more"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "and %lld more"
                }
              }
            }
          }
        }
      }
    },
    "Another copy of Linen is running. Changes in this window won’t be saved." : {
      "comment" : "Brief notice at the bottom of the window when Linen starts while another copy of it already has the session open — a second build during development, usually. That copy keeps the tabs; this window opens empty and writes nothing down. Sentence case, two short sentences."
    },
    "Answer…" : {

    },
    "Anthropic" : {
      "comment" : "Vendor name, shown as the API dialect a custom endpoint speaks. Leave as is."
    },
    "Any server that uses the OpenAI chat API." : {
      "comment" : "Settings → Assistant → Add a provider. Caption on the row for connecting a server the user runs themselves."
    },
    "API configuration" : {

    },
    "API JSON" : {

    },
    "API key" : {
