    "update.banner.install" : {
      "comment" : "The one button that updates the app, in the update banner and on the About settings page. One click downloads the update, installs it and restarts Linen; there is no second step. A verb (a command). Its twin is the plain “Install” key, the extension button — the same English word for a different button, so the two are kept apart. The button is narrow, so keep this short.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Install"
          }
        }
      }
    },
    "update.banner.preparingShare" : {
      "comment" : "Title of the software-update button in the sidebar while the downloaded release is being unpacked. %@ is an already-formatted percentage and carries its own per-cent sign. Kept separate from “Preparing %@”, where %@ is a version number instead. The button is narrow, so keep this short.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
