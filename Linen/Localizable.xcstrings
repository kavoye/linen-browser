    "Ask %@" : {
      "comment" : "Assistant action text in the command palette and section heading in the address bar results. %@ is the provider and model name, such as “OpenAI (gpt-5.6-luna)”. Keep that name unchanged."
    },
    "Ask about the %@ page" : {
      "comment" : "Heading of the empty assistant chat that sits beside a page. %@ is the name of the website the chat will read, taken from its address, e.g. “Github” — never translated. The same heading reads “Ask about this page” when there is no page yet."
    },
    "Ask about this page" : {

