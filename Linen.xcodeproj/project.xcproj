{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/huggingface/AnyLanguageModel.git",
      "version": {
        "up-to-next-major-version": "1.0.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/modelcontextprotocol/swift-sdk.git",
      "version": {
        "version": "0.12.1",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/apple/swift-log.git",
      "version": {
        "up-to-next-major-version": "1.5.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/sparkle-project/Sparkle",
      "version": {
        "up-to-next-major-version": "2.10.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/groue/GRDB.swift",
      "version": {
        "up-to-next-major-version": "7.11.1",
      },
    },
  ],
  "files": [
    {
      "kind": "folder",
      "path": "Linen",
      "target-membership": [
        "Linen",
      ],
      "membership-exceptions": [
        {
          "target": "Linen",
          "exclusions": [
            "Resources/Info.plist",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "LinenTests", "target-membership": [ "LinenTests" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Linen.app", "id": "EE41BFE23027B875008F6668", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/LinenTests.xctest", "id": "EEC0DE100000000000000002", "type": "wrapper.cfbundle", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "Linen",
      "id": "EE41BFE13027B875008F6668",
      "product": "Products/Linen.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "package": "AnyLanguageModel",
          "product-name": "AnyLanguageModel",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "GRDB",
          "product-name": "GRDB",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "Sparkle",
          "product-name": "Sparkle",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swift-log",
          "product-name": "Logging",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swift-sdk",
          "product-name": "MCP",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "Linen/Resources/Linen.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "COMBINE_HIDPI_IMAGES": "YES",
        "CURRENT_PROJECT_VERSION": "1",
        "DEAD_CODE_STRIPPING": "YES",
        "DEVELOPMENT_TEAM": "T8677WC8DG",
        "ENABLE_APP_SANDBOX": "NO",
