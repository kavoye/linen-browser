        "ENABLE_RESOURCE_ACCESS_AUDIO_INPUT": "YES",
        "ENABLE_RESOURCE_ACCESS_CAMERA": "YES",
        "ENABLE_USER_SELECTED_FILES": "readonly",
        "GENERATE_INFOPLIST_FILE": "YES",
        "GITHUB_OAUTH_CLIENT_ID": "Ov23liyHrHMecQlQ4QLS",
        "INFOPLIST_FILE": "Linen/Resources/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Linen",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.productivity",
        "INFOPLIST_KEY_NSCameraUsageDescription": "Only websites you allow can use your camera.",
        "INFOPLIST_KEY_NSLocationUsageDescription": "Only websites you allow can use your location.",
        "INFOPLIST_KEY_NSLocationWhenInUseUsageDescription": "Only websites you allow can use your location.",
        "INFOPLIST_KEY_NSMicrophoneUsageDescription": "Linen uses your microphone for dictation and voice conversations. Websites can use it only with your permission.",
        "LD_RUNPATH_SEARCH_PATHS": [
